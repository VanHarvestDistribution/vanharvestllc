---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found (404) | Van Harvest LLC" description="The page you requested is not available." active="" noindex>
  <section class="inner-hero" style="min-height:70svh">
    <div class="shell inner-grid">
      <div>
        <h1>Page not found</h1>
        <p class="not-found-zh">页面不存在</p>
      </div>
      <div class="inner-copy">
        <p>The page you requested is not available. Return home or continue to the wholesale product catalog.</p>
        <p>您访问的页面不存在，可以返回首页或浏览产品目录。</p>
        <div class="hero-actions" style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="button" href="/">Return to home →</a>
          <a class="button button-outline-dark" href="/products/">Browse products →</a>
          <a class="button button-outline-dark" href="/zh/products/">中文产品目录 →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
