---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
import { heroImage, contact } from '@/data/site';
---
<BaseLayout title="About Van Harvest Distribution | Charlotte Food Supplier" description="Learn about Van Harvest Distribution, a Charlotte wholesale supplier of meat, poultry, produce, seafood, prepared foods and restaurant essentials." active="/company" ogImage={heroImage}>
  <section class="inner-hero"><div class="shell inner-grid"><div class="reveal"><p class="eyebrow">About Van Harvest</p><h1>A practical partner<br />for <em>professional kitchens.</em></h1></div><div class="inner-copy reveal"><p>Based in Charlotte, Van Harvest Distribution brings a broad foodservice assortment together in one organized catalog—from fresh and frozen proteins to specialty produce and prepared foods.</p></div></div></section>
  <div class="wide-image"><img src={heroImage} alt="Organized refrigerated food distribution warehouse" /></div>
  <section class="story"><div class="shell story-grid"><div class="reveal"><p class="eyebrow">Our role</p><h2>Selection with<br /><em>operational clarity.</em></h2><p>Restaurant purchasing is detailed work. Van Harvest keeps that work grounded in clear item numbers, recognizable product descriptions and a catalog designed around the categories kitchens use every day.</p><p>Our Charlotte location and direct phone line make it easy to begin a conversation about products, availability and the right contact for your needs.</p></div><div class="principles reveal"><div class="principle"><span>01</span><div><h3>Catalog depth</h3><p>Thousands of food and foodservice items across nine practical departments.</p></div></div><div class="principle"><span>02</span><div><h3>Category clarity</h3><p>A simple number system helps teams move quickly through a broad assortment.</p></div></div><div class="principle"><span>03</span><div><h3>Direct contact</h3><p>A Charlotte office, one dependable phone number and department-specific paths.</p></div></div></div></div></section>
  <section class="facts"><div class="shell"><p class="eyebrow reveal">Van Harvest at a glance</p><div class="facts-grid"><article class="fact reveal"><span>01 / Location</span><h3>Charlotte, North Carolina</h3><p>{contact.address}</p></article><article class="fact reveal"><span>02 / Assortment</span><h3>Food + operations</h3><p>Proteins, produce, seafood, pantry ingredients, prepared foods and restaurant supplies.</p></article><article class="fact reveal"><span>03 / Access</span><h3>Talk with our team</h3><p>Call {contact.phoneDisplay} for current product and department information.</p></article></div></div></section>
  <CallToAction />
</BaseLayout>
