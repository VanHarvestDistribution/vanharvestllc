---
import productsData from '@/data/products.json';
import { categories } from '@/data/site';
import LocalizedProductDetail from '@/components/LocalizedProductDetail.astro';

type Product = { id: string; name: string; nameZh: string; category: string; packSize?: string; storage?: string; active: boolean };
export function getStaticPaths() {
  const allProducts = productsData as Product[];
  return allProducts.map((product) => ({ params: { category: product.category, itemNumber: product.id }, props: { product, category: categories.find((entry) => entry.key === product.category) || categories[0] } }));
}
const { product, category } = Astro.props as { product: Product; category: typeof categories[number] };
---
<LocalizedProductDetail product={product} category={category} lang="en" />
