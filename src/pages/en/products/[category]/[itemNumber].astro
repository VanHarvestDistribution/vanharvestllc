---
import products from '@/data/products.json';
export function getStaticPaths() {
  const all = products as any[];
  return all.map((product) => ({
    params: { category: product.category, itemNumber: product.id }
  }));
}
const { category, itemNumber } = Astro.params;
const target = `/products/${category}/${itemNumber}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://vanharvest.com${target}`} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>...</p>
  </body>
</html>
