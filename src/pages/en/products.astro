---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CallToAction from '@/components/CallToAction.astro';
import ProductsSubnav from '@/components/ProductsSubnav.astro';
import products from '@/data/products.json';
---
<BaseLayout title="Wholesale Food Departments | Van Harvest" description="Browse nine Van Harvest wholesale food departments and search the complete bilingual product catalog." active="/products" lang="en"><section class="inner-hero products-intro"><div class="shell inner-grid"><div><p class="eyebrow">Product departments</p><h1>Start with a<br /><em>category.</em></h1></div><div class="inner-copy"><p>Explore nine foodservice departments and selected products. Search all {products.length.toLocaleString()} listed products when you know what you need.</p><a class="button" href="/en/products/catalog">Search products →</a></div></div></section><ProductsSubnav lang="en" localized active="departments" /><CategoryGallery lang="en" /><section class="catalog-portal"><div class="shell catalog-portal-grid"><div><p class="eyebrow">Full catalog search</p><h2>Ready to find a<br /><em>specific item?</em></h2></div><div><p>Search by Item #, English name or Chinese name in a dedicated catalog view.</p><a class="text-link" href="/en/products/catalog">Search the full catalog →</a></div></div></section><CallToAction lang="en" localized /></BaseLayout>
