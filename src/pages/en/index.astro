---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeCatalogMarquee from '@/components/HomeCatalogMarquee.astro';
import products from '@/data/products.json';
---
<BaseLayout title="Van Harvest | Wholesale Food Distribution" description="Wholesale food distribution for Charlotte restaurants, supermarkets and professional kitchens." active="/" lang="en"><section class="home-hero"><div class="home-hero-shade"></div><div class="shell hero-inner"><div class="hero-topline"><span>Wholesale food distribution</span><span>Charlotte, North Carolina</span></div><div class="hero-copy reveal"><p class="eyebrow">Built for professional kitchens</p><h1>Good food starts<br />with a <em>reliable source.</em></h1><div class="hero-copy-bottom"><p>Fresh, frozen and dry goods for restaurants, supermarkets and foodservice teams.</p><a class="button" href="/en/products">Explore our catalog →</a></div></div><div class="hero-bottom"><div class="hero-stats"><div><strong>{products.length.toLocaleString()}+</strong><span>catalog items</span></div><div><strong>CLT</strong><span>home base</span></div></div></div></div></section><HomeCatalogMarquee /></BaseLayout>
