---
import LocalizedProductDetail from '@/components/LocalizedProductDetail.astro';
import { categories } from '@/data/site';
export function getStaticPaths(){ return categories.map((category) => ({ params: { category: category.key }, props: { category } })); }
const { category } = Astro.props;
---
<LocalizedProductDetail product={{ id: 'category', name: category.name, nameZh: '', category: category.key, storage: 'dry', packSize: '' }} category={category} lang="zh" />
