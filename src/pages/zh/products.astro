---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CallToAction from '@/components/CallToAction.astro';
import ProductsSubnav from '@/components/ProductsSubnav.astro';
import products from '@/data/catalog.json';
---
<BaseLayout title="夏洛特食品批发产品分类 | Van Harvest 万昌" description="浏览 Van Harvest 万昌的九大食品批发品类，服务夏洛特及北卡餐馆、超市和亚洲厨房，支持中英文产品搜索。" active="/products/" lang="zh"><section class="inner-hero products-intro"><div class="shell inner-grid"><div><h1>夏洛特食品批发品类</h1></div><div class="inner-copy"><p>浏览九大餐饮供应品类和精选产品；需要精确查找时，可搜索全部 {products.length.toLocaleString()} 个上架产品。</p><a class="button" href="/zh/products/catalog/">搜索产品 →</a></div></div></section><ProductsSubnav lang="zh" localized active="departments" /><CategoryGallery lang="zh" /><section class="catalog-portal"><div class="shell catalog-portal-grid"><div><h2>完整产品目录</h2></div><div><p>在独立目录页按产品编号、英文名或中文名搜索，无需逐一翻阅品类。</p><a class="text-link" href="/zh/products/catalog/">搜索完整目录 →</a></div></div></section><CallToAction lang="zh" localized /></BaseLayout>
