---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CallToAction from '@/components/CallToAction.astro';
import ProductsSubnav from '@/components/ProductsSubnav.astro';
import products from '@/data/products.json';
---
<BaseLayout title="产品分类 | Van Harvest" description="浏览 Van Harvest 九大食品批发品类，需要时再进入完整双语产品目录搜索。" active="/products" lang="zh"><section class="inner-hero products-intro"><div class="shell inner-grid"><div><p class="eyebrow">产品分类</p><h1>从经营的<br /><em>品类开始。</em></h1></div><div class="inner-copy"><p>浏览九个餐饮供应品类及其精选产品。需要精确查找时，可进入完整双语目录搜索全部 {products.length.toLocaleString()} 个已清洗产品。</p><a class="button" href="/zh/products/catalog">打开完整目录 →</a></div></div></section><ProductsSubnav lang="zh" localized active="departments" /><CategoryGallery lang="zh" /><section class="catalog-portal"><div class="shell catalog-portal-grid"><div><p class="eyebrow">完整目录搜索</p><h2>知道要找什么？<br /><em>直接搜索。</em></h2></div><div><p>在独立目录界面按 Item #、英文名或中文名搜索，不打断上方按图片浏览九大品类的体验。</p><a class="text-link" href="/zh/products/catalog">搜索完整目录 →</a></div></div></section><CallToAction lang="zh" localized /></BaseLayout>
