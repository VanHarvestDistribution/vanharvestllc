---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CatalogExplorer from '@/components/CatalogExplorer';
import CallToAction from '@/components/CallToAction.astro';
---
<BaseLayout title="产品目录 | Van Harvest" description="按 Item #、英文名或中文名搜索 Van Harvest 食品批发产品。" active="/products" lang="zh"><section class="inner-hero"><div class="shell inner-grid"><div><p class="eyebrow">产品目录</p><h1>找到合适的<br /><em>产品。</em></h1></div><div class="inner-copy"><p>先按九个可视化品类浏览，再按 Item #、英文名或中文名搜索双语目录。</p></div></div></section><CategoryGallery lang="zh" /><section class="catalog-section-index"><div class="shell"><CatalogExplorer lang="zh" /></div></section><CallToAction lang="zh" localized /></BaseLayout>
