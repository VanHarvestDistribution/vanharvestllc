---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CallToAction from '@/components/CallToAction.astro';
import ProductsSubnav from '@/components/ProductsSubnav.astro';
import products from '@/data/products.json';
---
<BaseLayout title="Wholesale Food Product Departments | Van Harvest Charlotte" description="Browse Van Harvest's nine image-led wholesale food departments, then open the full bilingual product catalog when you are ready to search." active="/products">
  <section class="inner-hero products-intro"><div class="shell inner-grid"><div><p class="eyebrow">Product departments</p><h1>Start with a<br /><em>category.</em></h1></div><div class="inner-copy"><p>Explore nine foodservice departments and their featured products. When you know what you need, open the full bilingual catalog to search all {products.length.toLocaleString()} cleaned items.</p><a class="button" href="/products/catalog">Open full catalog →</a></div></div></section>
  <ProductsSubnav active="departments" />
  <CategoryGallery />
  <section class="catalog-portal"><div class="shell catalog-portal-grid"><div><p class="eyebrow">Full catalog search</p><h2>Ready to find a<br /><em>specific item?</em></h2></div><div><p>Search by Item #, English name or Chinese name in a dedicated catalog view—without interrupting the visual department browse above.</p><a class="text-link" href="/products/catalog">Search the full catalog →</a></div></div></section>
  <CallToAction />
</BaseLayout>
