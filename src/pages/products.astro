---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CallToAction from '@/components/CallToAction.astro';
import ProductsSubnav from '@/components/ProductsSubnav.astro';
import products from '@/data/products.json';
---
<BaseLayout title="Wholesale Food Departments | Van Harvest" description="Browse nine Van Harvest wholesale food departments and search the complete bilingual product catalog." active="/products/"><section class="inner-hero products-intro"><div class="shell inner-grid"><div><h1>Foodservice departments</h1></div><div class="inner-copy"><p>Explore nine wholesale departments with {products.length.toLocaleString()} listed items. Search by Item #, English name, or Chinese name in the catalog.</p><a class="button" href="/products/catalog/">Search products →</a></div></div></section><ProductsSubnav active="departments" /><CategoryGallery /><section class="catalog-portal"><div class="shell catalog-portal-grid"><div><h2>Full catalog search</h2></div><div><p>Search by Item #, English name or Chinese name in a dedicated catalog view.</p><a class="text-link" href="/products/catalog/">Search the full catalog →</a></div></div></section><CallToAction /></BaseLayout>
