---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CatalogExplorer from '@/components/CatalogExplorer';
import CategoryGallery from '@/components/CategoryGallery.astro';
import CallToAction from '@/components/CallToAction.astro';
import products from '@/data/products.json';
---
<BaseLayout title="Wholesale Food Product Catalog | Van Harvest Charlotte" description="Explore image-led food categories or search Van Harvest wholesale items by product number, English name or Chinese name." active="/products">
  <section class="inner-hero products-intro"><div class="shell inner-grid"><div><p class="eyebrow">Product catalog</p><h1>Start with a<br /><em>category.</em></h1></div><div class="inner-copy"><p>Browse a department to see product-specific Featured Products, or search all {products.length.toLocaleString()} catalog records in one place.</p><a class="button" href="/catalog/van-harvest-product-catalog.pdf" target="_blank" rel="noopener noreferrer">Download complete PDF ↗</a></div></div></section>
  <CategoryGallery />
  <section class="catalog-section catalog-section-index" id="catalog"><div class="shell"><div class="catalog-explorer-heading"><div><p class="eyebrow">Search the complete inventory</p><h2>Already know<br /><em>what you need?</em></h2></div><p>Search the full catalog by Item #, English name or Chinese name. Use the visual category cards above to begin a more focused browse.</p></div><div class="catalog-intro-note"><span>Search by Item #, English name or Chinese name</span><span>{products.length.toLocaleString()} cleaned catalog records</span></div><CatalogExplorer client:load /></div></section>
  <CallToAction />
</BaseLayout>
