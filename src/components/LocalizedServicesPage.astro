---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
interface Props { lang: 'en' | 'zh'; localized?: boolean }
const { lang, localized = false } = Astro.props; const zh = lang === 'zh'; const prefix = localized ? `/${lang}` : '';
const blocks = zh ? [
  { label:'配送与订单支持', eyebrow:'配送服务', title:'让厨房持续运转。', copy:'从配送安排、产品替代到收货问题与退换货沟通，团队协助你把日常采购安排得更顺畅。', points:['区域配送','订单协调','产品咨询','退换货支持'] },
  { label:'开户与下单方式', eyebrow:'账户服务', title:'准备好下一次采购。', copy:'新客户可在线申请开户；账户建立后，可通过电话、短信或微信与团队沟通下单需求。', points:['申请开户','电话下单','短信 / 微信','账户服务'] },
  { label:'产品与餐饮用品', eyebrow:'九大品类', title:'一站采购，更有效率。', copy:'从肉类禽类、蔬菜水果、海鲜到米面干货、餐饮用品与清洁用品，按厨房所需查找产品。', points:['新鲜及冷冻肉类','蔬菜水果','海鲜','餐饮用品'] }
] : [
  { label:'Delivery & order care', eyebrow:'Delivery service', title:'Keep the kitchen moving.', copy:'From route planning and substitutions to receiving questions and returns, the team helps keep everyday purchasing organized.', points:['Regional delivery','Order coordination','Product support','Returns support'] },
  { label:'Account setup & ordering', eyebrow:'Account service', title:'Set up your next order.', copy:'New customers can apply online. Once your account is established, you can discuss ordering by phone, text message or WeChat.', points:['Account application','Phone ordering','SMS / WeChat','Account support'] },
  { label:'Food & restaurant supplies', eyebrow:'Nine departments', title:'One source, more efficient purchasing.', copy:'Find the categories professional kitchens use every day, from meat, produce and seafood to dry goods, supplies and cleaning essentials.', points:['Fresh & frozen meat','Produce & fruit','Seafood','Restaurant supplies'] }
];
---
<BaseLayout title={zh ? '配送、开户与下单服务 | Van Harvest' : 'Food Delivery, Ordering & Account Services | Van Harvest'} description={zh ? '了解 Van Harvest 的配送、开户、下单与售后支持。' : 'Explore Van Harvest delivery, wholesale account, ordering and customer support services.'} active="/services" lang={lang}><section class="inner-hero"><div class="shell inner-grid"><div class="reveal"><p class="eyebrow">{zh ? '我们如何支持厨房' : 'How we support kitchens'}</p><h1>{zh ? <>供应支持，<br /><em>少一点阻力。</em></> : <>Supply support<br />with <em>less friction.</em></>}</h1></div><div class="inner-copy reveal"><p>{zh ? '从配送、开户到产品问题和退换货，Van Harvest 帮助餐饮经营者把采购安排得更顺畅。' : 'From delivery and account setup to product questions and returns, Van Harvest helps foodservice operators keep purchasing organized.'}</p><a class="text-link" href={`${prefix}/apply`}>{zh ? '申请开户 →' : 'Apply for an account →'}</a></div></div></section><section class="services-list">{blocks.map((block, i) => <article class="service-block"><div class:list={['service-visual', i === 1 && 'is-produce', i === 2 && 'is-gold']}><p>{block.label}</p></div><div class="service-content reveal"><span class="eyebrow">{block.eyebrow}</span><h2>{block.title}</h2><p>{block.copy}</p><div class="service-points">{block.points.map((point) => <span>{point}</span>)}</div></div></article>)}</section><CallToAction lang={lang} localized={localized} /></BaseLayout>
