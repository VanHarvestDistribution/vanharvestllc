---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact } from '@/data/site';

interface Props { lang: 'en' | 'zh'; localized?: boolean }
const { lang, localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';

const title = zh
  ? '下单与配送 | Van Harvest'
  : 'Ordering & Delivery | Van Harvest';

const description = zh
  ? '在 Van Harvest 开户、下单和收货的方式：24 小时电话或短信下单，无截单时间，货车送货上门，最低起送额 $500。'
  : 'How to open an account, place orders and get deliveries from Van Harvest. Order 24/7 with no cutoff time, truck delivery and $500 minimum.';

const steps = zh
  ? [
      {
        num: '1',
        title: '申请开户',
        desc: '在线填写开户申请，办公室会联系您完成开户。'
      },
      {
        num: '2',
        title: '随时下单',
        desc: '电话或短信下单，24 小时都可以，没有截单时间。'
      },
      {
        num: '3',
        title: '送货上门',
        desc: '我们自己的货车送货，到货时请与司机当面核对。'
      }
    ]
  : [
      {
        num: '1',
        title: 'Apply for an account',
        desc: 'Fill out the online application. Our office will contact you to set it up.'
      },
      {
        num: '2',
        title: 'Order anytime',
        desc: 'Call or text your order 24/7. There is no order cutoff time.'
      },
      {
        num: '3',
        title: 'We deliver',
        desc: 'Your order arrives on our truck. Check it with the driver at the door.'
      }
    ];

const deliveryRows = zh
  ? [
      { area: '北卡 NC', plan: '每天配送' },
      { area: '南卡 SC', plan: '每天配送' },
      { area: '弗吉尼亚 VA', plan: '按需安排，请来电预约' },
      { area: '亚特兰大 GA', plan: '按需安排，请来电预约' },
    ]
  : [
      { area: 'North Carolina', plan: 'Daily' },
      { area: 'South Carolina', plan: 'Daily' },
      { area: 'Virginia', plan: 'Scheduled — call to arrange' },
      { area: 'Atlanta, Georgia', plan: 'Scheduled — call to arrange' },
    ];
---
<BaseLayout title={title} description={description} active="/services" lang={lang}>
  <div class="services-clean-page">
    <header class="services-clean-header">
      <div class="shell">
        <h1>{zh ? '下单与配送' : 'Ordering & Delivery'}</h1>
        <p class="services-clean-intro">
          {zh ? '在 Van Harvest 开户、下单和收货的方式。' : 'How to open an account, place orders and get deliveries from Van Harvest.'}
        </p>
      </div>
    </header>

    <!-- Visual Banner: Real warehouse & logistics operations -->
    <div class="shell services-photo-grid">
      <figure class="services-photo-item">
        <img src="/images/facilities/warehouse-facility.webp" alt={zh ? 'Van Harvest 食品仓库备货与分拣' : 'Van Harvest warehouse staging and picking'} loading="eager" />
        <figcaption>{zh ? '29,000 平方英尺仓库分拣与备货' : '29,000 SF warehouse staging and order picking'}</figcaption>
      </figure>
      <figure class="services-photo-item">
        <img src="/images/home/hero-cold-chain.webp" alt={zh ? 'Van Harvest 冷链配送货车' : 'Van Harvest refrigerated delivery truck fleet'} loading="eager" />
        <figcaption>{zh ? '自有冷链车队与装车' : 'Dedicated refrigerated fleet and loading'}</figcaption>
      </figure>
      <figure class="services-photo-item">
        <img src="/images/facilities/distribution-facility.webp" alt={zh ? 'Van Harvest 区域配送与月台装卸' : 'Van Harvest distribution operations and dock staging'} loading="eager" />
        <figcaption>{zh ? '区域配送月台与装运' : 'Regional dock staging and outbound routing'}</figcaption>
      </figure>
    </div>

    <!-- Section 1: How ordering works -->
    <section class="services-section">
      <div class="shell">
        <div class="services-section-head">
          <h2>{zh ? '下单流程' : 'How ordering works'}</h2>
        </div>
        <div class="services-steps-grid">
          {steps.map((step) => (
            <article class="services-step-card">
              <span class="step-badge">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 2: Delivery -->
    <section class="services-section">
      <div class="shell">
        <div class="services-section-head">
          <h2>{zh ? '配送' : 'Delivery'}</h2>
        </div>
        <div class="services-table-wrap">
          <table class="services-clean-table">
            <thead>
              <tr>
                <th scope="col">{zh ? '地区' : 'Area'}</th>
                <th scope="col">{zh ? '配送安排' : 'Delivery'}</th>
              </tr>
            </thead>
            <tbody>
              {deliveryRows.map((row) => (
                <tr>
                  <td><strong>{row.area}</strong></td>
                  <td>{row.plan}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="services-min-order">
            {zh ? '最低起送额：每次 $500。' : 'Minimum order: $500 per delivery.'}
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Payment -->
    <section class="services-section">
      <div class="shell">
        <div class="services-section-head">
          <h2>{zh ? '付款方式' : 'Payment'}</h2>
        </div>
        <div class="services-prose-card">
          <p>
            {zh
              ? '新客户货到付款（COD）。合作满一个月后，可申请账期。'
              : 'New accounts pay COD (cash on delivery). After one month of ordering with us, you can apply for payment terms.'}
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: Shortages & returns -->
    <section class="services-section">
      <div class="shell">
        <div class="services-section-head">
          <h2>{zh ? '缺货与退换' : 'Shortages & returns'}</h2>
        </div>
        <div class="services-prose-card">
          <p>
            {zh
              ? '到货时请与司机当面核对。如有破损、缺货或送错，当场告诉司机，免费退换。'
              : 'Check your order with the driver when it arrives. If anything is damaged, missing or wrong, tell the driver on the spot — we exchange or credit it free of charge.'}
          </p>
        </div>
      </div>
    </section>

    <!-- Section 5: Contact -->
    <section class="services-section services-contact-section">
      <div class="shell">
        <div class="services-section-head">
          <h2>{zh ? '联系我们' : 'Contact'}</h2>
        </div>
        <div class="services-contact-card">
          <p class="contact-entry">
            <strong>{zh ? '电话 / 短信下单：' : 'Phone / text orders: '}</strong>
            <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
          </p>
          <p class="contact-entry">
            <strong>{zh ? '仓库与办公室地址：' : 'Address: '}</strong>
            <span>{contact.address}</span>
          </p>
          <div class="services-action-buttons">
            <a class="button" href={`${prefix}/apply/`}>
              {zh ? '申请开户 →' : 'Apply for an account →'}
            </a>
            <a class="button button-outline" href={`tel:${contact.phoneHref}`}>
              {zh ? `致电 ${contact.phoneDisplay}` : `Call ${contact.phoneDisplay}`}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
