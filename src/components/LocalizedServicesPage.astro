---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact } from '@/data/site';

interface Props { lang: 'en' | 'zh'; localized?: boolean }
const { lang, localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';

const title = zh
  ? '北卡南卡食品配送与下单 | Van Harvest 万昌'
  : 'Restaurant Food Delivery Charlotte NC & North Carolina | Van Harvest LLC';

const description = zh
  ? 'Van Harvest 万昌为夏洛特及北卡、南卡餐馆提供食品批发配送。电话或短信 24 小时下单，无截单时间，每次最低起送额 $500。'
  : 'Order wholesale food from Van Harvest LLC in Charlotte. Call or text 24/7 for NC and SC delivery, with no cutoff time and a $500 minimum.';

const steps = zh
  ? [
      {
        num: '01',
        title: '申请开户',
        desc: '在线填写开户申请，办公室会联系您完成开户。'
      },
      {
        num: '02',
        title: '随时下单',
        desc: '电话或短信下单，24 小时都可以，没有截单时间。'
      },
      {
        num: '03',
        title: '送货上门',
        desc: '我们自己的货车送货，到货时请与司机当面核对。'
      }
    ]
  : [
      {
        num: '01',
        title: 'Apply for an account',
        desc: 'Fill out the online application. Our office will contact you to set it up.'
      },
      {
        num: '02',
        title: 'Order anytime',
        desc: 'Call or text your order 24/7. There is no order cutoff time.'
      },
      {
        num: '03',
        title: 'We deliver',
        desc: 'Your order arrives on our truck. Check it with the driver at the door.'
      }
    ];

const deliveryRows = zh
  ? [
      { area: '北卡 NC', plan: '每天配送' },
      { area: '南卡 SC', plan: '每天配送' },
      { area: '弗吉尼亚 VA', plan: '按需安排，请来电预约' },
      { area: '佐治亚州', plan: '按需安排，请来电预约' },
    ]
  : [
      { area: 'North Carolina', plan: 'Daily' },
      { area: 'South Carolina', plan: 'Daily' },
      { area: 'Virginia', plan: 'Scheduled — call to arrange' },
      { area: 'Atlanta, Georgia', plan: 'Scheduled — call to arrange' },
    ];
---
<BaseLayout title={title} description={description} active="/services" lang={lang}>
  <div class="services-editorial-page">
    <!-- 1. Split Hero: 70vh split screen (Left: Real Warehouse photo; Right: Dark Navy with 64px H1 and 3 key metrics) -->
    <header class="services-editorial-hero">
      <div class="editorial-hero-media">
        <img
          src="/images/facilities/warehouse-facility.webp"
          alt={zh ? 'Van Harvest 夏洛特中央仓库实拍' : 'Van Harvest Charlotte warehouse facility'}
          loading="eager"
        />
      </div>
      <div class="editorial-hero-content">
        <div class="editorial-hero-inner">
          <h1>{zh ? '下单与配送' : 'Ordering & Delivery'}</h1>
          <p class="editorial-hero-sub">
            {zh
              ? '在 Van Harvest 开户、下单和收货的方式。'
              : 'How to open an account, place orders and get deliveries from Van Harvest.'}
          </p>
          <div class="editorial-hero-divider"></div>
          <div class="editorial-hero-metrics">
            <div class="hero-metric-item">
              <span class="metric-val">24/7</span>
              <span class="metric-lbl">{zh ? '随时下单' : 'ordering'}</span>
            </div>
            <div class="hero-metric-item">
              <span class="metric-val">$500</span>
              <span class="metric-lbl">{zh ? '每次起送' : 'minimum order'}</span>
            </div>
            <div class="hero-metric-item">
              <span class="metric-val">{zh ? '每日' : 'Daily'}</span>
              <span class="metric-lbl">NC &amp; SC</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- 2. "How ordering works": Full width 1200px container, 3 unboxed columns, giant thin 01/02/03 numerals -->
    <section class="editorial-section">
      <div class="editorial-container">
        <div class="editorial-section-header">
          <h2>{zh ? '下单流程' : 'How ordering works'}</h2>
        </div>
        <div class="editorial-rule"></div>
        <div class="editorial-steps-grid">
          {steps.map((step) => (
            <div class="editorial-step-col">
              <span class="editorial-step-num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. "Delivery": Timetable style full-width clean row list separated by subtle hairline dividers -->
    <section class="editorial-section">
      <div class="editorial-container">
        <div class="editorial-section-header">
          <h2>{zh ? '配送' : 'Delivery'}</h2>
        </div>
        <div class="editorial-timetable">
          {deliveryRows.map((row) => (
            <div class="timetable-row">
              <span class="timetable-area">{row.area}</span>
              <span class="timetable-plan">{row.plan}</span>
            </div>
          ))}
        </div>
        <div class="editorial-timetable-footer">
          <p>
            {zh ? (
              <>最低起送额 — <strong>$500</strong> 每次配送</>
            ) : (
              <>Minimum order — <strong>$500</strong> per delivery</>
            )}
          </p>
        </div>
      </div>
    </section>

    <!-- 4. "Payment" & "Shortages & returns": Two wide unboxed columns side by side -->
    <section class="editorial-section">
      <div class="editorial-container">
        <div class="editorial-two-col-grid">
          <div class="editorial-col">
            <h2>{zh ? '付款方式' : 'Payment'}</h2>
            <div class="editorial-rule"></div>
            <p>
              {zh
                ? '新客户货到付款（COD）。合作满一个月后，可申请账期。'
                : 'New accounts pay COD (cash on delivery). After one month of ordering with us, you can apply for payment terms.'}
            </p>
          </div>
          <div class="editorial-col">
            <h2>{zh ? '缺货与退换' : 'Shortages & returns'}</h2>
            <div class="editorial-rule"></div>
            <p>
              {zh
                ? '到货时请与司机当面核对。如有破损、缺货或送错，当场告诉司机，免费退换。'
                : 'Check your order with the driver when it arrives. If anything is damaged, missing or wrong, tell the driver on the spot — we exchange or credit it free of charge.'}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Full-width dark navy banner with 72px phone number and high-contrast action buttons -->
    <section class="editorial-contact-banner">
      <div class="editorial-container contact-banner-inner">
        <p class="contact-banner-sub">
          {zh ? '电话或短信下单' : 'Call or text your order'}
        </p>
        <a class="contact-banner-phone" href={`tel:${contact.phoneHref}`}>
          {contact.phoneDisplay}
        </a>
        <p class="contact-banner-address">{contact.address}</p>
        <div class="contact-banner-actions">
          <a class="button button-gold" href={`${prefix}/apply/`}>
            {zh ? '申请开户 →' : 'Apply for an account →'}
          </a>
          <a class="button button-white-outline" href={`tel:${contact.phoneHref}`}>
            {zh ? `致电 ${contact.phoneDisplay}` : `Call ${contact.phoneDisplay}`}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
