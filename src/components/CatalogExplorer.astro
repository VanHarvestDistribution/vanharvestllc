---
import { categories } from '@/data/site';
import { productImages } from '@/data/productImages';

interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const STEP = 50;
const imageIds = Object.keys(productImages);
const labels = zh ? {
  all: '全部产品', searchLabel: '搜索产品', placeholder: 'Item #、英文或中文名', quick: '快速筛选', loading: '正在加载产品目录…', noResults: '暂无匹配产品', noResultsBody: '请尝试产品编号、英文名、中文名或品类。', clear: '清除筛选', product: '产品名称', item: 'Item #', storage: '温层', frozen: '冷冻', refrigerated: '冷藏'
} : {
  all: 'All products', searchLabel: 'Search products', placeholder: 'Item #, English or Chinese name', quick: 'Quick filter', loading: 'Loading product catalog…', noResults: 'No matching products', noResultsBody: 'Try an Item #, English name, Chinese name or category.', clear: 'Clear filters', product: 'Product', item: 'Item #', storage: 'Storage', frozen: 'Frozen', refrigerated: 'Refrigerated'
};
---
<div class="catalog-shell catalog-shell-wide" data-catalog data-labels={JSON.stringify(labels)} data-step={STEP} data-image-ids={JSON.stringify(imageIds)}>
  <div class="catalog-main">
    <div class="catalog-search">
      <label for="product-search">{labels.searchLabel}</label>
      <input id="product-search" type="search" placeholder={labels.placeholder} autocomplete="off" />
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    </div>
    <div class="catalog-filter-row" aria-label={zh ? '快速筛选' : 'Quick category filter'}>
      <span>{labels.quick}</span>
      <div>
        {[{ key: 'all', name: labels.all }, ...categories.map((item) => ({ key: item.key, name: zh ? item.nameZh : item.name }))].map((item) => (
          <button type="button" class:list={['category-pill', { 'is-active': item.key === 'all' }]} data-category={item.key} aria-pressed={item.key === 'all'}>{item.name}</button>
        ))}
      </div>
    </div>
    <div class="catalog-summary" aria-live="polite"><span data-current-name>{labels.all}</span><span data-result-count>{labels.loading}</span></div>
    <div class="catalog-table-wrap">
      <table class="catalog-table">
        <thead><tr><th class="col-id">{labels.item}</th><th class="col-product">{labels.product}</th><th class="col-storage">{labels.storage}</th><th class="col-cart"><span class="sr-only">{zh ? '加入购物车' : 'Add to cart'}</span></th></tr></thead>
        <tbody data-product-results><tr><td colspan="4" class="catalog-loading-row">{labels.loading}</td></tr></tbody>
      </table>
    </div>
    <div class="pager-wrap" data-pager-wrap hidden>
      <p class="pager-status" data-pager-status aria-live="polite"></p>
      <nav class="pager" data-pager aria-label={zh ? '产品分页' : 'Product pages'}></nav>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-catalog]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const labels = JSON.parse(root.dataset.labels || '{}');
    const imageIds = new Set(JSON.parse(root.dataset.imageIds || '[]').map(String));
    const step = Number(root.dataset.step || 50);
    const input = root.querySelector('#product-search');
    const tbody = root.querySelector('[data-product-results]');
    const nameNode = root.querySelector('[data-current-name]');
    const countNode = root.querySelector('[data-result-count]');
    const pagerWrap = root.querySelector('[data-pager-wrap]');
    const pagerNav = root.querySelector('[data-pager]');
    const pagerStatus = root.querySelector('[data-pager-status]');
    const isZh = document.documentElement.lang === 'zh-CN';
    const pagerHtml = (page, pages, zh) => {
      if (pages <= 1) return '';
      const nums = [];
      for (let i = 1; i <= pages; i++) {
        if (i === 1 || i === pages || Math.abs(i - page) <= 1) nums.push(i);
        else if (nums[nums.length - 1] !== '…') nums.push('…');
      }
      const btn = (label, target, extra = '', aria = '') => `<button type="button" data-page="${target}" ${extra}${aria ? ` aria-label="${aria}"` : ''}>${label}</button>`;
      return btn('‹', page - 1, page <= 1 ? 'disabled' : '', zh ? '上一页' : 'Previous page')
        + nums.map((n) => n === '…' ? '<span class="pager-gap" aria-hidden="true">…</span>' : btn(String(n), n, n === page ? 'class="is-current" aria-current="page"' : '', (zh ? '第 ' + n + ' 页' : 'Page ' + n))).join('')
        + btn('›', page + 1, page >= pages ? 'disabled' : '', zh ? '下一页' : 'Next page');
    };
    const rangeText = (page, size, total, zh) => {
      const from = total ? (page - 1) * size + 1 : 0;
      const to = Math.min(page * size, total);
      return zh ? `第 ${from}–${to} 个，共 ${total.toLocaleString()} 个产品` : `Showing ${from}–${to} of ${total.toLocaleString()} products`;
    };
    const syncUrl = () => {
      const url = new URL(location.href);
      const set = (key, value) => { if (value) url.searchParams.set(key, value); else url.searchParams.delete(key); };
      set('category', category !== 'all' ? category : '');
      set('q', query.trim());
      set('page', page > 1 ? String(page) : '');
      history.replaceState(history.state, '', url);
    };

    const buttons = [...root.querySelectorAll('[data-category]')];
    const categoryCache = new Map();
    let index = [];
    let category = 'all';
    let query = '';
    let page = 1;
    const synonyms = { wing: ['chicken wing', '鸡翅'], '鸡翅': ['wing', 'chicken wing'], shrimp: ['虾'], '虾': ['shrimp'], tofu: ['豆腐'], '豆腐': ['tofu'], beef: ['牛', '牛肉'], pork: ['猪', '猪肉'], fish: ['鱼'] };
    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
    const normalize = (value) => value.trim().toLowerCase().replace(/chiken/g, 'chicken').replace(/porkk/g, 'pork');
    const matches = (product, rawTerm) => { const term = normalize(rawTerm); if (!term) return true; const haystack = `${product.id} ${product.name} ${product.nameZh || ''}`.toLowerCase(); return [term, ...(synonyms[term] || [])].some((needle) => haystack.includes(needle)); };
    const storageText = (product) => product.storage === 'frozen' ? labels.frozen : product.storage === 'refrigerated' ? labels.refrigerated : '';
    const resultText = (count) => document.documentElement.lang === 'zh-CN' ? `${count.toLocaleString()} 个结果` : `${count.toLocaleString()} ${count === 1 ? 'result' : 'results'}`;
    const nameFor = (key) => buttons.find((button) => button.dataset.category === key)?.textContent?.trim() || labels.all;
    const loadCategory = async (key) => {
      if (!categoryCache.has(key)) {
        categoryCache.set(key, fetch(`/data/categories/${encodeURIComponent(key)}.json`, { credentials: 'same-origin' }).then((response) => { if (!response.ok) throw new Error('Category request failed'); return response.json(); }));
      }
      return categoryCache.get(key);
    };
    const zhPage = document.documentElement.lang === 'zh-CN';
    const rowHtml = (product) => {
      const linked = imageIds.has(String(product.id));
      const name = linked ? `<a class="catalog-product-link" href="${document.documentElement.lang === 'zh-CN' ? '/zh' : ''}/products/${encodeURIComponent(product.category)}/${encodeURIComponent(product.id)}/"><span class="name-en">${escapeHtml(product.name)}</span>${product.nameZh ? `<span class="name-zh">${escapeHtml(product.nameZh)}</span>` : ''}</a>` : `<span class="name-en">${escapeHtml(product.name)}</span>${product.nameZh ? `<span class="name-zh">${escapeHtml(product.nameZh)}</span>` : ''}`;
      const storage = storageText(product);
      return `<tr class="catalog-product-row"><td class="col-id"><code>${escapeHtml(product.id)}</code></td><td class="col-product">${name}<div class="catalog-mobile-meta">${storage ? `<span><strong>${document.documentElement.lang === 'zh-CN' ? '温层' : 'Storage'}:</strong> ${storage}</span>` : ''}</div></td><td class="col-storage">${storage ? `<span class="storage-badge ${product.storage}">${storage}</span>` : ''}</td><td class="col-cart"><button type="button" class="add-cart-btn" data-add-to-cart data-id="${escapeHtml(product.id)}" data-name="${escapeHtml(product.name)}" data-name-zh="${escapeHtml(product.nameZh || '')}" data-category="${escapeHtml(product.category || '')}" aria-label="${escapeHtml((zhPage ? '加入购物车：' : 'Add to cart: ') + (zhPage && product.nameZh ? product.nameZh : product.name))}"><span aria-hidden="true">+</span><span data-add-label>${zhPage ? '加入' : 'Add'}</span></button></td></tr>`;
    };
    const render = async () => {
      const filteredIndex = index.filter((product) => (category === 'all' || product.category === category) && matches(product, query));
      nameNode.textContent = nameFor(category); countNode.textContent = resultText(filteredIndex.length);
      if (!filteredIndex.length) { tbody.innerHTML = `<tr><td colspan="4"><div class="empty-state"><h3>${labels.noResults}</h3><p>${labels.noResultsBody}</p><button type="button" data-clear>${labels.clear}</button></div></td></tr>`; pagerWrap.hidden = true; return; }
      const pages = Math.max(1, Math.ceil(filteredIndex.length / step));
      page = Math.min(Math.max(1, page), pages);
      const visible = filteredIndex.slice((page - 1) * step, page * step);
      tbody.innerHTML = `<tr><td colspan="4" class="catalog-loading-row">${labels.loading}</td></tr>`;
      try {
        const keys = [...new Set(visible.map((product) => product.category))];
        const groups = await Promise.all(keys.map((key) => loadCategory(key)));
        const details = new Map(groups.flat().map((product) => [String(product.id), product]));
        tbody.innerHTML = visible.map((product) => rowHtml(details.get(String(product.id)) || product)).join('');
      } catch (_) { tbody.innerHTML = `<tr><td colspan="4" class="catalog-loading-row">${labels.noResultsBody}</td></tr>`; }
      pagerWrap.hidden = pages <= 1; pagerNav.innerHTML = pagerHtml(page, pages, isZh); pagerStatus.textContent = rangeText(page, step, filteredIndex.length, isZh); syncUrl();
      buttons.forEach((button) => { const active = button.dataset.category === category; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
    };
    const boot = async () => {
      try { const response = await fetch('/data/catalog-index.json', { credentials: 'same-origin' }); if (!response.ok) throw new Error('Index request failed'); index = await response.json(); render(); } catch (_) { countNode.textContent = labels.noResults; tbody.innerHTML = `<tr><td colspan="4" class="catalog-loading-row">${labels.noResultsBody}</td></tr>`; }
    };
    const params = new URLSearchParams(location.search); if (buttons.some((button) => button.dataset.category === params.get('category'))) category = params.get('category'); if (params.get('q')) { query = params.get('q'); input.value = query; } page = parseInt(params.get('page') || '1', 10) || 1;
    input.addEventListener('input', () => { query = input.value; page = 1; render(); });
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.category || 'all'; page = 1; render(); }));
    pagerNav.addEventListener('click', (event) => { const button = event.target.closest('button[data-page]'); if (!button || button.disabled) return; page = parseInt(button.dataset.page, 10); render().then(() => root.querySelector('.catalog-summary')?.scrollIntoView({ behavior: 'smooth', block: 'start' })); });
    boot();
  })();
</script>
