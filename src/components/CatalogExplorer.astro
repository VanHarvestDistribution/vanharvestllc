---
import { categories } from '@/data/site';

interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const STEP = 50;
const labels = zh ? {
  all: '全部产品',
  searchLabel: '搜索产品',
  placeholder: 'Item #、英文或中文名',
  quick: '快速筛选',
  loading: '正在加载产品目录…',
  noResults: '暂无匹配产品',
  noResultsBody: '请尝试产品编号、英文名、中文名或品类。',
  clear: '清除筛选',
  load: '加载更多',
  product: '产品名称',
  item: 'Item #',
  pack: '包装 / Pack',
  storage: '温层 / Storage',
  action: '查看详情',
  frozen: '冷冻',
  refrigerated: '冷藏'
} : {
  all: 'All products',
  searchLabel: 'Search products',
  placeholder: 'Item #, English or Chinese name',
  quick: 'Quick filter',
  loading: 'Loading product catalog…',
  noResults: 'No matching products',
  noResultsBody: 'Try an Item #, English name, Chinese name or category.',
  clear: 'Clear filters',
  load: 'Load more',
  product: 'Product description',
  item: 'Item #',
  pack: 'Pack size',
  storage: 'Storage',
  action: 'View details',
  frozen: 'Frozen',
  refrigerated: 'Refrigerated'
};
---
<div class="catalog-shell catalog-shell-wide" data-catalog data-labels={JSON.stringify(labels)} data-step={STEP}>
  <div class="catalog-main">
    <div class="catalog-search">
      <label for="product-search">{labels.searchLabel}</label>
      <input id="product-search" type="search" placeholder={labels.placeholder} autocomplete="off" />
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    </div>

    <div class="catalog-filter-row" aria-label={zh ? '快速筛选' : 'Quick category filter'}>
      <span>{labels.quick}</span>
      <div>
        {[{ key: 'all', name: labels.all }, ...categories.map((item) => ({ key: item.key, name: zh ? item.nameZh : item.name }))].map((item) => (
          <button type="button" class:list={['category-pill', { 'is-active': item.key === 'all' }]} data-category={item.key} aria-pressed={item.key === 'all'}>{item.name}</button>
        ))}
      </div>
    </div>

    <div class="catalog-summary" aria-live="polite">
      <span data-current-name>{labels.all}</span>
      <span data-result-count>{labels.loading}</span>
    </div>

    <div class="catalog-table-wrap">
      <table class="catalog-table">
        <thead>
          <tr>
            <th class="col-id">{labels.item}</th>
            <th class="col-product">{labels.product}</th>
            <th class="col-pack">{labels.pack}</th>
            <th class="col-storage">{labels.storage}</th>
            <th class="col-action"><span class="sr-only">{labels.action}</span></th>
          </tr>
        </thead>
        <tbody data-product-results>
          <tr><td colspan="5" class="catalog-loading-row">{labels.loading}</td></tr>
        </tbody>
      </table>
    </div>

    <div class="load-more" data-load-wrap hidden>
      <button type="button" data-load-more class="button button-outline"></button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-catalog]');
    if (!root) return;

    const labels = JSON.parse(root.dataset.labels || '{}');
    const step = Number(root.dataset.step || 50);
    const input = root.querySelector('#product-search');
    const tbody = root.querySelector('[data-product-results]');
    const nameNode = root.querySelector('[data-current-name]');
    const countNode = root.querySelector('[data-result-count]');
    const loadWrap = root.querySelector('[data-load-wrap]');
    const loadButton = root.querySelector('[data-load-more]');
    const buttons = [...root.querySelectorAll('[data-category]')];

    const getCatalog = () => {
      if (!window.__vhCatalogPromise) {
        window.__vhCatalogPromise = fetch('/data/catalog.json', { credentials: 'same-origin' })
          .then((response) => {
            if (!response.ok) throw new Error(`Catalog request failed: ${response.status}`);
            return response.json();
          });
      }
      return window.__vhCatalogPromise;
    };

    const synonyms = {
      wing: ['chicken wing', '鸡翅'],
      '鸡翅': ['wing', 'chicken wing'],
      shrimp: ['虾'],
      '虾': ['shrimp'],
      tofu: ['豆腐'],
      '豆腐': ['tofu'],
      beef: ['牛', '牛肉'],
      pork: ['猪', '猪肉'],
      fish: ['鱼']
    };

    let allProducts = [];
    let category = 'all';
    let query = '';
    let limit = step;

    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
    const normalize = (value) => value.trim().toLowerCase().replace(/chiken/g, 'chicken').replace(/porkk/g, 'pork');
    const matches = (product, rawTerm) => {
      const term = normalize(rawTerm);
      if (!term) return true;
      const haystack = `${product.id} ${product.name} ${product.nameZh || ''}`.toLowerCase();
      return [term, ...(synonyms[term] || [])].some((needle) => haystack.includes(needle));
    };
    const storageText = (product) => product.storage === 'frozen' ? labels.frozen : product.storage === 'refrigerated' ? labels.refrigerated : '';
    const storageBadge = (product) => {
      const text = storageText(product);
      return text ? `<span class="storage-badge ${product.storage}">${text}</span>` : '';
    };
    const resultText = (count) => {
      const isZh = document.documentElement.lang === 'zh-CN';
      return isZh ? `${count.toLocaleString()} 个结果` : `${count.toLocaleString()} ${count === 1 ? 'result' : 'results'}`;
    };
    const nameFor = (key) => buttons.find((button) => button.dataset.category === key)?.textContent?.trim() || labels.all;
    const rowHtml = (product) => {
      const meta = [
        product.packSize ? `<span><strong>${document.documentElement.lang === 'zh-CN' ? '规格' : 'Pack'}:</strong> ${escapeHtml(product.packSize)}</span>` : '',
        storageText(product) ? `<span><strong>${document.documentElement.lang === 'zh-CN' ? '温层' : 'Storage'}:</strong> ${storageText(product)}</span>` : ''
      ].filter(Boolean).join('');
      return `<tr class="catalog-product-row" data-product-open data-product-id="${escapeHtml(product.id)}" tabindex="0" role="button" aria-label="${escapeHtml(`${labels.action}: ${product.name || product.nameZh || product.id}`)}">
        <td class="col-id"><code>${escapeHtml(product.id)}</code></td>
        <td class="col-product"><span class="name-en">${escapeHtml(product.name)}</span>${product.nameZh ? `<span class="name-zh">${escapeHtml(product.nameZh)}</span>` : ''}<div class="catalog-mobile-meta">${meta}</div></td>
        <td class="col-pack">${escapeHtml(product.packSize || '—')}</td>
        <td class="col-storage">${storageBadge(product)}</td>
        <td class="col-action"><span class="text-link">${labels.action} →</span></td>
      </tr>`;
    };

    const render = () => {
      const filtered = allProducts.filter((product) => (category === 'all' || product.category === category) && matches(product, query));
      nameNode.textContent = nameFor(category);
      countNode.textContent = resultText(filtered.length);

      if (!filtered.length) {
        tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state"><h3>${labels.noResults}</h3><p>${labels.noResultsBody}</p><button type="button" data-clear>${labels.clear}</button></div></td></tr>`;
      } else {
        tbody.innerHTML = filtered.slice(0, limit).map(rowHtml).join('');
      }

      const remaining = filtered.length - limit;
      loadWrap.hidden = remaining <= 0;
      loadButton.textContent = `${labels.load} · ${Math.min(step, Math.max(remaining, 0))}`;
      buttons.forEach((button) => {
        const active = button.dataset.category === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      tbody.querySelector('[data-clear]')?.addEventListener('click', () => {
        category = 'all'; query = ''; limit = step; input.value = ''; render();
      });
    };

    const params = new URLSearchParams(location.search);
    if (buttons.some((button) => button.dataset.category === params.get('category'))) category = params.get('category');
    if (params.get('q')) { query = params.get('q'); input.value = query; }

    input.addEventListener('input', () => { query = input.value; limit = step; render(); });
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.category || 'all'; limit = step; render(); }));
    loadButton.addEventListener('click', () => { limit += step; render(); });

    getCatalog().then((products) => {
      allProducts = products;
      render();
    }).catch(() => {
      countNode.textContent = labels.noResults;
      tbody.innerHTML = `<tr><td colspan="5" class="catalog-loading-row">${labels.noResultsBody}</td></tr>`;
    });
  })();
</script>
