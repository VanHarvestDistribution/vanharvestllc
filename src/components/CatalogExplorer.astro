---
import productsData from '@/data/products.json';
import { categories } from '@/data/site';
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const STEP = 50;
const products = productsData as Array<{ id: string; name: string; nameZh: string; category: string; packSize?: string; storage?: string }>;
const initialProducts = products.slice(0, STEP);
const labels = zh ? {
  all: '全部产品',
  searchLabel: '搜索产品',
  placeholder: 'Item #、英文或中文名',
  quick: '快速筛选',
  noResults: '暂无匹配产品',
  noResultsBody: '请尝试产品编号、英文名、中文名或品类。',
  clear: '清除筛选',
  load: '加载更多',
  product: '产品名称',
  item: 'Item #',
  pack: '包装 / Pack',
  storage: '温层 / Storage',
  action: '详情'
} : {
  all: 'All products',
  searchLabel: 'Search products',
  placeholder: 'Item #, English or Chinese name',
  quick: 'Quick filter',
  noResults: 'No matching products',
  noResultsBody: 'Try an Item #, English name, Chinese name or category.',
  clear: 'Clear filters',
  load: 'Load more',
  product: 'Product description',
  item: 'Item #',
  pack: 'Pack size',
  storage: 'Storage',
  action: 'Details'
};

const storageMap: Record<string, { en: string; zh: string; cls: string }> = {
  frozen: { en: 'Frozen', zh: '冷冻', cls: 'frozen' },
  refrigerated: { en: 'Refrigerated', zh: '冷藏', cls: 'refrigerated' },
  dry: { en: 'Shelf-stable', zh: '常温', cls: 'dry' }
};

const catalogData = JSON.stringify(products).replace(/</g, '\\u003c');
const labelData = JSON.stringify(labels).replace(/</g, '\\u003c');
const storageMapData = JSON.stringify(storageMap).replace(/</g, '\\u003c');
---
<div class="catalog-shell catalog-shell-wide" data-catalog data-prefix={prefix} data-labels={labelData} data-storage-map={storageMapData} data-step={STEP}>
  <div class="catalog-main">
    <div class="catalog-search">
      <label for="product-search">{labels.searchLabel}</label>
      <input id="product-search" type="search" placeholder={labels.placeholder} autocomplete="off" />
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    </div>

    <div class="catalog-filter-row" aria-label={zh ? '快速筛选' : 'Quick category filter'}>
      <span>{labels.quick}</span>
      <div>
        {[{ key: 'all', name: labels.all }, ...categories.map((item) => ({ key: item.key, name: zh ? item.nameZh : item.name }))].map((item) => (
          <button type="button" class:list={['category-pill', { 'is-active': item.key === 'all' }]} data-category={item.key} aria-pressed={item.key === 'all'}>{item.name}</button>
        ))}
      </div>
    </div>

    <div class="catalog-summary" aria-live="polite">
      <span data-current-name>{labels.all}</span>
      <span data-result-count>{zh ? `${products.length.toLocaleString()} 个结果` : `${products.length.toLocaleString()} results`}</span>
    </div>

    <div class="catalog-table-wrap">
      <table class="catalog-table">
        <thead>
          <tr>
            <th class="col-id">{labels.item}</th>
            <th class="col-product">{labels.product}</th>
            <th class="col-pack">{labels.pack}</th>
            <th class="col-storage">{labels.storage}</th>
            <th class="col-action"></th>
          </tr>
        </thead>
        <tbody data-product-results>
          {initialProducts.map((product) => {
            const storageMeta = product.storage && storageMap[product.storage];
            return (
              <tr>
                <td class="col-id"><code>{product.id}</code></td>
                <td class="col-product">
                  <a href={`${prefix}/products/${product.category}/${product.id}`}>
                    <span class="name-en">{product.name}</span>
                    {product.nameZh && <span class="name-zh">{product.nameZh}</span>}
                  </a>
                  <div class="catalog-mobile-meta">
                    {product.packSize && <span><strong>{zh ? '规格' : 'Pack'}:</strong> {product.packSize}</span>}
                    {storageMeta && <span><strong>{zh ? '温层' : 'Storage'}:</strong> {zh ? storageMeta.zh : storageMeta.en}</span>}
                  </div>
                </td>
                <td class="col-pack">{product.packSize || '—'}</td>
                <td class="col-storage">
                  {storageMeta ? (
                    <span class:list={['storage-badge', storageMeta.cls]}>{zh ? storageMeta.zh : storageMeta.en}</span>
                  ) : (
                    '—'
                  )}
                </td>
                <td class="col-action"><a class="text-link" href={`${prefix}/products/${product.category}/${product.id}`}>{labels.action} →</a></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="load-more" data-load-wrap hidden>
      <button type="button" data-load-more class="button button-outline"></button>
    </div>
  </div>
</div>

<script id="catalog-data" type="application/json" set:html={catalogData}></script>

<script is:inline>
  const root = document.querySelector('[data-catalog]');
  if (root) {
    const allProducts = JSON.parse(document.querySelector('#catalog-data')?.textContent || '[]');
    const labels = JSON.parse(root.dataset.labels || '{}');
    const storageMap = JSON.parse(root.dataset.storageMap || '{}');
    const prefix = root.dataset.prefix || '';
    const step = Number(root.dataset.step || 50);

    const input = root.querySelector('#product-search');
    const tbody = root.querySelector('[data-product-results]');
    const nameNode = root.querySelector('[data-current-name]');
    const countNode = root.querySelector('[data-result-count]');
    const loadWrap = root.querySelector('[data-load-wrap]');
    const loadButton = root.querySelector('[data-load-more]');
    const buttons = [...root.querySelectorAll('[data-category]')];

    const synonyms = {
      wing: ['chicken wing','鸡翅'],
      '鸡翅': ['wing','chicken wing'],
      shrimp: ['虾'],
      '虾': ['shrimp'],
      tofu: ['豆腐'],
      '豆腐': ['tofu'],
      beef: ['牛','牛肉'],
      pork: ['猪','猪肉'],
      fish: ['鱼']
    };

    let category = 'all';
    let query = '';
    let limit = step;

    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[char]));

    const renderStorageBadge = (storageKey) => {
      if (!storageKey || !storageMap[storageKey]) return '—';
      const meta = storageMap[storageKey];
      const isZh = document.documentElement.lang === 'zh-CN';
      return `<span class="storage-badge ${meta.cls}">${isZh ? meta.zh : meta.en}</span>`;
    };

    const rowHtml = (product) => {
      const isZh = document.documentElement.lang === 'zh-CN';
      const storageText = product.storage && storageMap[product.storage] ? (isZh ? storageMap[product.storage].zh : storageMap[product.storage].en) : '';
      return `
        <tr>
          <td class="col-id"><code>${escapeHtml(product.id)}</code></td>
          <td class="col-product">
            <a href="${prefix}/products/${product.category}/${product.id}">
              <span class="name-en">${escapeHtml(product.name)}</span>
              ${product.nameZh ? `<span class="name-zh">${escapeHtml(product.nameZh)}</span>` : ''}
            </a>
            <div class="catalog-mobile-meta">
              ${product.packSize ? `<span><strong>${isZh ? '规格' : 'Pack'}:</strong> ${escapeHtml(product.packSize)}</span>` : ''}
              ${storageText ? `<span><strong>${isZh ? '温层' : 'Storage'}:</strong> ${storageText}</span>` : ''}
            </div>
          </td>
          <td class="col-pack">${escapeHtml(product.packSize || '—')}</td>
          <td class="col-storage">${renderStorageBadge(product.storage)}</td>
          <td class="col-action"><a class="text-link" href="${prefix}/products/${product.category}/${product.id}">${labels.action} →</a></td>
        </tr>
      `;
    };

    const nameFor = (key) => buttons.find((button) => button.dataset.category === key)?.textContent?.trim() || labels.all;
    const normalize = (value) => value.trim().toLowerCase().replace(/chiken/g, 'chicken').replace(/porkk/g, 'pork');

    const matches = (product, rawTerm) => {
      const term = normalize(rawTerm);
      if (!term) return true;
      const haystack = `${product.id} ${product.name} ${product.nameZh || ''}`.toLowerCase();
      return [term, ...(synonyms[term] || [])].some((needle) => haystack.includes(needle));
    };

    const resultText = (count) => {
      const isZh = document.documentElement.lang === 'zh-CN';
      return isZh ? `${count.toLocaleString()} 个结果` : `${count.toLocaleString()} ${count === 1 ? 'result' : 'results'}`;
    };

    const render = () => {
      const filtered = allProducts.filter((product) => (category === 'all' || product.category === category) && matches(product, query));
      nameNode.textContent = nameFor(category);
      countNode.textContent = resultText(filtered.length);

      if (!filtered.length) {
        tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state"><h3>${labels.noResults}</h3><p>${labels.noResultsBody}</p><button type="button" data-clear>${labels.clear}</button></div></td></tr>`;
      } else {
        tbody.innerHTML = filtered.slice(0, limit).map(rowHtml).join('');
      }

      const remaining = filtered.length - limit;
      loadWrap.hidden = remaining <= 0;
      loadButton.textContent = `${labels.load} · ${Math.min(step, Math.max(remaining, 0))}`;

      buttons.forEach((button) => {
        const active = button.dataset.category === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      tbody.querySelector('[data-clear]')?.addEventListener('click', () => {
        category = 'all'; query = ''; limit = step; input.value = ''; render();
      });
    };

    const params = new URLSearchParams(location.search);
    if (buttons.some((button) => button.dataset.category === params.get('category'))) {
      category = params.get('category');
    }
    if (params.get('q')) {
      query = params.get('q');
      input.value = query;
    }

    input.addEventListener('input', () => { query = input.value; limit = step; render(); });
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.category || 'all'; limit = step; render(); }));
    loadButton.addEventListener('click', () => { limit += step; render(); });
    render();
  }
</script>
