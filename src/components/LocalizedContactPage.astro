---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DepartmentContactForm from '@/components/DepartmentContactForm.astro';
import { contact } from '@/data/site';
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const departments = zh ? [
  ['销售', '产品与开户咨询', '直达销售'], ['客服', '当前订单与服务问题', '办公室转交'], ['采购', '供应商和产品沟通', '办公室转交'], ['人事', '招聘和工作相关咨询', '办公室转交']
] : [
  ['Sales', 'Product and account inquiries', 'Direct to sales'], ['Customer Service', 'Current order and service questions', 'Office routing'], ['Purchasing', 'Vendor and product conversations', 'Office routing'], ['Human Resources', 'Employment and workplace inquiries', 'Office routing']
];
---
<BaseLayout title={zh ? '联系 Van Harvest | Charlotte, NC' : 'Contact Van Harvest Distribution | Charlotte, NC'} description={zh ? `联系 Van Harvest：${contact.address}。拨打 ${contact.phoneDisplay}。` : `Contact Van Harvest Distribution at ${contact.address}. Call ${contact.phoneDisplay}.`} active="/contact" lang={lang}>
<section class="inner-hero"><div class="shell inner-grid"><div><p class="eyebrow">{zh ? '联系 Van Harvest' : 'Contact Van Harvest'}</p><h1>{zh ? <>从正确的<br /><em>沟通开始。</em></> : <>Start with the<br /><em>right conversation.</em></>}</h1></div><div class="inner-copy"><p>{zh ? '联系 Charlotte 办公室，或给 Van Harvest 团队发送信息。销售咨询会直接发送给销售团队，其他需求由办公室进行分派。' : 'Call our Charlotte office or send a message to the Van Harvest team. Sales messages go directly to sales; other requests are routed through the office.'}</p></div></div></section>
<section class="contact-section"><div class="shell contact-grid"><div class="contact-details"><p class="eyebrow">{zh ? 'Charlotte 办公室' : 'Charlotte office'}</p><h2>{zh ? <>我们愿意<br /><em>帮助你。</em></> : <>We’re here<br /><em>to help.</em></>}</h2><div class="contact-line"><div><small>{zh ? '电话' : 'Phone'}</small><a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a></div></div><div class="contact-line"><div><small>{zh ? '销售邮箱' : 'Sales email'}</small><a href={`mailto:${contact.salesEmail}`}>{contact.salesEmail}</a></div></div><div class="contact-line"><div><small>{zh ? '办公室邮箱' : 'Office email'}</small><a href={`mailto:${contact.officeEmail}`}>{contact.officeEmail}</a></div></div><div class="contact-line"><div><small>{zh ? '地址' : 'Address'}</small><a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{contact.address} ↗</a></div></div><div class="map-widget"><iframe src={contact.mapsEmbedUrl} title="Van Harvest office location on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div><div class="contact-line"><div><small>{zh ? '导航' : 'Directions'}</small><a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{zh ? '在 Google Maps 中打开 ↗' : 'Open in Google Maps ↗'}</a></div></div></div><div class="department-panel"><p class="eyebrow">{zh ? '选择部门' : 'Choose a department'}</p><p>{zh ? '选择销售、客服、采购或人事。销售咨询会直接发送至 ordersvhd@gmail.com；其他部门邮件会发送至办公室邮箱。' : 'Choose Sales, Customer Service, Purchasing or Human Resources. Sales inquiries go directly to ordersvhd@gmail.com; other department messages are routed through the office mailbox.'}</p><div class="department-list">{departments.map(([title, copy, status]) => <article class="department-card"><div><h3>{title}</h3><p>{copy}</p></div><small class="status-pill">{status}</small></article>)}</div><DepartmentContactForm lang={lang} /><div class="contact-callout"><p>{zh ? '需要立即协助？办公室主线是最快联系团队的方式。' : 'Need assistance now? Our main line is the fastest way to reach the team.'}</p><a class="button" href={`tel:${contact.phoneHref}`}>{zh ? `拨打 ${contact.phoneDisplay}` : `Call ${contact.phoneDisplay}`}</a></div></div></div></section>
</BaseLayout>
