---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DepartmentContactForm from '@/components/DepartmentContactForm.astro';
import { contact } from '@/data/site';

interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const departments = zh
  ? [
      ['销售', '电话 / 短信下单与开户', '直达销售'],
      ['客服', '送货到店与退换核对', '办公室转交'],
      ['采购', '供应商合作与报价', '办公室转交'],
      ['人事', '司机与仓库人员招聘', '办公室转交'],
    ]
  : [
      ['Sales', 'Phone / text ordering & accounts', 'Direct to sales'],
      ['Customer Service', 'Delivery check-in & returns', 'Office routing'],
      ['Purchasing', 'Supplier partnerships & quotes', 'Office routing'],
      ['Human Resources', 'Driver & warehouse hiring', 'Office routing'],
    ];
---
<BaseLayout
  title={zh ? '夏洛特食品批发联系方式 | Van Harvest 万昌' : 'Contact Van Harvest LLC | Charlotte Wholesale Food Supplier'}
  description={zh
    ? `联系 Van Harvest 万昌：${contact.address}。夏洛特食品批发、开户和配送咨询请致电或短信 ${contact.phoneDisplay}。`
    : `Contact Van Harvest LLC in Charlotte at 5226 Terminal St or call/text ${contact.phoneDisplay} for wholesale food, account and delivery support.`}
  active="/contact"
  lang={lang}
>
  <section class="inner-hero">
    <div class="shell inner-grid">
      <div>
        <h1>{zh ? '联系 Van Harvest 万昌' : 'Contact Van Harvest LLC in Charlotte'}</h1>
      </div>
      <div class="inner-copy">
        <p>
          {zh
            ? '电话或短信下单 24 小时均可接收。销售咨询直达销售团队，其他需求由办公室统一分派处理。'
            : 'Phone or text orders are accepted 24/7. Sales inquiries go directly to our sales desk; other inquiries are routed through the office.'}
        </p>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="shell contact-grid">
      <aside class="contact-details">
        <h2>{zh ? '夏洛特仓库与办公室' : 'Charlotte warehouse & office'}</h2>
        <div class="contact-information" aria-label={zh ? '联系方式' : 'Contact details'}>
          <div class="contact-line">
            <small>{zh ? '电话 / 短信下单' : 'Phone / text orders'}</small>
            <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
          </div>
          <div class="contact-line">
            <small>{zh ? '销售邮箱' : 'Sales email'}</small>
            <span>{contact.salesEmail}</span>
          </div>
          <div class="contact-line">
            <small>{zh ? '办公室邮箱' : 'Office email'}</small>
            <span>{contact.officeEmail}</span>
          </div>
          <div class="contact-line contact-line-address">
            <small>{zh ? '仓库地址' : 'Warehouse address'}</small>
            <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{contact.address} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="map-widget">
          <iframe src={contact.mapsEmbedUrl} title="Van Harvest office location on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="contact-line contact-line-directions">
          <small>{zh ? '地图导航' : 'Directions'}</small>
          <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{zh ? '在 Google Maps 中打开 ↗' : 'Open in Google Maps ↗'}</a>
        </div>
      </aside>

      <div class="department-panel">
        <h2>{zh ? '发送信息' : 'Send a message'}</h2>
        <p>{zh ? '请选择对应业务部门。所有表单信息都会发送至 ordersvhd@gmail.com。' : 'Select a department. Every form submission is sent to ordersvhd@gmail.com.'}</p>
        <div class="department-list">
          {departments.map(([title, copy, status]) => (
            <article class="department-card">
              <div><h3>{title}</h3><p>{copy}</p></div>
              <small class="status-pill">{status}</small>
            </article>
          ))}
        </div>
        <DepartmentContactForm lang={lang} />
        <div class="contact-callout">
          <p>{zh ? '紧急下单或查货？电话或短信联系我们最快。' : 'Need immediate order placement? Calling or texting our main line is the fastest way.'}</p>
          <a class="button" href={`tel:${contact.phoneHref}`}>{zh ? `致电 ${contact.phoneDisplay}` : `Call ${contact.phoneDisplay}`}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
