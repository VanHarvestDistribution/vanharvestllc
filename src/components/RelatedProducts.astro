---
import productsData from '@/data/products.json';
import { productImageFor } from '@/data/productImages';

interface Props { product: any; category: any; lang?: 'en' | 'zh'; localized?: boolean }
const { product, category, lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const allProducts = productsData as any[];
const currentImage = productImageFor(product.id);
const usedImages = new Set<string>(currentImage ? [currentImage] : []);

// Extract meaningful keywords from product name (remove numbers, units, pack words)
const cleanTokens = product.name
  .toLowerCase()
  .replace(/\b(\d+|lb|lbs|oz|gal|kg|cs|ct|pk|pkg|bag|box)\b/g, '')
  .match(/[a-z]{3,}/g) || [];

const isKeywordMatch = (candidateName: string) => {
  const lower = candidateName.toLowerCase();
  return cleanTokens.some((tok: string) => lower.includes(tok));
};

// Candidate pools sorted by relevance:
// 1. Same category + keyword match
// 2. Same category + same storage
// 3. Same category others
const pool = allProducts.filter((item) => item.category === product.category && item.id !== product.id);

pool.sort((a, b) => {
  const aKw = isKeywordMatch(a.name) ? 2 : 0;
  const bKw = isKeywordMatch(b.name) ? 2 : 0;
  const aSt = (a.storage && a.storage === product.storage) ? 1 : 0;
  const bSt = (b.storage && b.storage === product.storage) ? 1 : 0;
  return (bKw + bSt) - (aKw + aSt);
});

const related: Array<{ product: any; image?: string }> = [];
for (const candidate of pool) {
  const candidateImage = productImageFor(candidate.id);
  const image = candidateImage && !usedImages.has(candidateImage) ? candidateImage : undefined;
  if (image) usedImages.add(image);
  related.push({ product: candidate, image });
  if (related.length === 8) break;
}

const categoryName = zh ? category.nameZh : category.name;
---
<section class="related-products">
  <div class="shell">
    <div class="related-heading">
      <div>
        <p class="eyebrow">{zh ? '继续浏览' : 'Keep browsing'}</p>
        <h2>{zh ? '同类产品' : 'Related products'}</h2>
      </div>
      <a class="text-link" href={`${prefix}/products/catalog?category=${category.key}#catalog`}>
        {zh ? `查看全部${categoryName} →` : `View all ${categoryName} →`}
      </a>
    </div>

    <div class="related-product-grid">
      {related.map(({ product: item, image }) => (
        <a class="related-product-card" href={`${prefix}/products/${category.key}/${item.id}`}>
          {image ? (
            <img src={image} alt={`${item.name} ${zh ? '产品实拍' : 'product photo'}`} loading="lazy" />
          ) : (
            <div class="related-product-placeholder" role="img" aria-label={`${categoryName} ${zh ? '分类产品' : 'category item'}`}>
              <span>VH · {categoryName}</span>
            </div>
          )}
          <div>
            <small>Item {item.id}</small>
            <h3>{zh ? (item.nameZh || item.name) : item.name}</h3>
            {zh ? item.nameZh && <p>{item.name}</p> : item.nameZh && <p>{item.nameZh}</p>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
