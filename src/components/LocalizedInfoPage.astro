---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact } from '@/data/site';
interface Props { kind: string; lang?: 'en' | 'zh'; }
const { kind, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const copy: Record<string, { eyebrow: string; title: string; intro: string }> = {
  apply: { eyebrow: zh ? '开户申请' : 'Account application', title: zh ? '让下一次采购更简单。' : 'Make the next order simpler.', intro: zh ? '填写基本信息，办公室团队会使用现有邮箱联系你。账期、最低起送额和配送政策将在确认后发布。' : 'Share the basics and the office team will follow up from the current mailbox. Terms, minimums and delivery policy will be published after confirmation.' },
  delivery: { eyebrow: zh ? '配送范围' : 'Delivery coverage', title: zh ? '覆盖四个配送区域。' : 'Four delivery regions, connected.', intro: zh ? 'Van Harvest 当前配送至 North Carolina、South Carolina、Atlanta, GA 和 Virginia。各路线的配送日、截单时间和最低起送额将在下单时由办公室确认。' : 'Van Harvest currently delivers across North Carolina, South Carolina, Atlanta, GA and Virginia. The office confirms delivery days, cutoff times and minimums for each route at order time.' },
  industries: { eyebrow: zh ? '我们服务谁' : 'Who we serve', title: zh ? '为每一种厨房准备。' : 'Built around the kitchen you run.', intro: zh ? '从中餐馆到亚洲超市，按你的经营方式浏览推荐品类。' : 'From Chinese restaurants to Asian supermarkets, browse categories around the way your operation works.' },
  careers: { eyebrow: zh ? '招聘' : 'Careers', title: zh ? '加入 Van Harvest。' : 'Join Van Harvest.', intro: zh ? '职位信息和招聘流程将在确认后发布。你可以先提交兴趣和联系方式。' : 'Open roles and hiring steps will be published after confirmation. Share your interest and contact details in the meantime.' },
  suppliers: { eyebrow: zh ? '供应商合作' : 'Supplier partnerships', title: zh ? '一起扩大餐饮选择。' : 'Bring the next product to kitchens.', intro: zh ? '供应商可以提交公司、产品和联系人信息，办公室会统一转交采购团队。' : 'Suppliers can share company, product and contact details; the office will route the message to purchasing.' },
  privacy: { eyebrow: zh ? '隐私政策' : 'Privacy policy', title: zh ? '你的信息应被认真对待。' : 'Your information matters.', intro: zh ? '这是隐私政策草案占位页，正式文本将在公司确认后替换。' : 'This is a draft placeholder for the privacy policy; final legal text will be added after company confirmation.' },
  terms: { eyebrow: zh ? '条款' : 'Terms', title: zh ? '使用网站前请阅读。' : 'Before you use the site.', intro: zh ? '这是网站条款草案占位页，正式文本将在公司确认后替换。' : 'This is a draft placeholder for website terms; final legal text will be added after company confirmation.' }
};
const text = copy[kind] || copy.industries;
const isForm = ['apply', 'careers', 'suppliers'].includes(kind);
const isIndustries = kind === 'industries';
const subject = kind === 'apply' ? 'Account application' : kind === 'suppliers' ? 'Supplier partnership' : 'Career inquiry';
---
<BaseLayout title={`${text.title} | Van Harvest`} description={text.intro} active="" lang={lang}>
  <section class="inner-hero"><div class="shell inner-grid"><div class="reveal"><p class="eyebrow">{text.eyebrow}</p><h1>{text.title}</h1></div><div class="inner-copy reveal"><p>{text.intro}</p></div></div></section>
  {isIndustries ? <section class="info-section"><div class="shell info-grid">{[{title: zh ? '中餐馆' : 'Chinese restaurants', copy: zh ? '肉类、海鲜、亚洲调味品和冷冻点心。' : 'Meat, seafood, Asian pantry staples and frozen prepared foods.', href: `/${lang}/products/meat`}, {title: zh ? '日料 / 亚洲餐馆' : 'Japanese & Asian restaurants', copy: zh ? '海鲜、蔬菜、米面和餐饮耗材。' : 'Seafood, produce, rice, noodles and foodservice supplies.', href: `/${lang}/products/seafood`}, {title: zh ? '超市 / 便利店' : 'Supermarkets & convenience stores', copy: zh ? '新鲜农产品、零食、饮料和包装食品。' : 'Fresh produce, snacks, beverages and packaged specialties.', href: `/${lang}/products/prepared`}].map((item, i) => <article class="info-card reveal"><span>0{i + 1}</span><h2>{item.title}</h2><p>{item.copy}</p><a class="text-link" href={item.href}>{zh ? '查看推荐品类 →' : 'Browse recommended categories →'}</a></article>)}</div></section> : kind === 'delivery' ? <section class="info-section"><div class="shell info-grid"><article class="info-card placeholder-card"><span>01</span><h2>{zh ? '配送区域' : 'Delivery territories'}</h2><p>{zh ? 'North Carolina · South Carolina · Atlanta, GA · Virginia' : 'North Carolina · South Carolina · Atlanta, GA · Virginia'}</p></article><article class="info-card placeholder-card"><span>02</span><h2>{zh ? '配送日与截单时间' : 'Delivery days & cutoffs'}</h2><p class="placeholder-copy">{zh ? '配送日和截单时间由办公室按路线确认。' : 'Delivery days and cutoffs are confirmed by the office for each route.'}</p></article><article class="info-card placeholder-card"><span>03</span><h2>{zh ? '最低起送额' : 'Minimum order'}</h2><p class="placeholder-copy">{zh ? '最低起送额由办公室按送货地址确认。' : 'Minimum order is confirmed by the office for each delivery address.'}</p></article></div></section> : isForm ? <section class="info-section"><div class="shell form-page-grid"><div class="info-card"><p class="eyebrow">{zh ? '信息提交' : 'Submit information'}</p><h2>{zh ? '我们会联系你。' : 'We will follow up.'}</h2><p>{zh ? '此表单会打开你的邮件客户端，发送到 Van Harvest 办公室邮箱。' : 'This form opens your email client and addresses the Van Harvest office mailbox.'}</p></div><form class="application-form" data-mail-form data-subject={subject}><label><span>{zh ? '公司名' : 'Company name'}</span><input name="company" required /></label><label><span>{zh ? '业务类型' : 'Business type'}</span><select name="businessType"><option>Restaurant / 餐馆</option><option>Supermarket / 超市</option><option>Other / 其他</option></select></label><label><span>{zh ? '地址' : 'Address'}</span><input name="address" /></label><div class="form-grid"><label><span>{zh ? '联系人' : 'Contact'}</span><input name="contact" required /></label><label><span>{zh ? '电话' : 'Phone'}</span><input name="phone" required /></label></div><label><span>{zh ? '邮箱' : 'Email'}</span><input type="email" name="email" required /></label>{kind === 'apply' && <><label><span>EIN</span><input name="ein" /></label><label><span>{zh ? '预计周采购量' : 'Expected weekly purchasing'}</span><input name="weeklyPurchasing" /></label><label><span>{zh ? '转售证明（PDF 或图片）' : 'Resale Certificate (PDF or image)'}</span><input type="file" name="resaleCertificate" accept="application/pdf,image/*" /></label><label class="checkbox-line"><input type="checkbox" name="netTerms" /> <span>{zh ? '申请账期' : 'Apply for credit terms'}</span></label></>}{kind !== 'apply' && <label><span>{zh ? '留言' : 'Message'}</span><textarea name="message" rows="5"></textarea></label>}<div class="form-actions"><button class="button" type="submit">{zh ? '发送 →' : 'Send →'}</button><span class="form-status" data-form-status aria-live="polite"></span></div></form></div></section> : <section class="info-section"><div class="shell info-reading"><p>{text.intro}</p><p class="placeholder-copy">{zh ? '正式内容占位符：待 Van Harvest 提供并审核后替换。' : 'Content placeholder: final Van Harvest-approved text will be added here.'}</p></div></section>}
</BaseLayout>
{isForm && <script is:inline define:vars={{ officeEmail: contact.officeEmail }}>{`document.querySelectorAll('[data-mail-form]').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const subject = form.dataset.subject || 'Van Harvest inquiry'; const body = Array.from(data.entries()).filter(([key, value]) => typeof value === 'string' && key !== 'resaleCertificate').map(([key, value]) => key + ': ' + value).join('\\n'); window.location.href = 'mailto:' + officeEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body); form.querySelector('[data-form-status]').textContent = 'Your email draft is ready / 邮件草稿已准备好'; }));`}</script>}
