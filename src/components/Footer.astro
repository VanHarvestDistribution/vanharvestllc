---
import { contact } from '@/data/site';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const href = (path: string) => (zh ? `/zh${path}` : path);
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <a class="brand brand-light official-brand footer-brand" href={href('/')}><img src="/brand/van-harvest-official-light-v2.webp" width="142" height="101" alt="Van Harvest LLC" /></a>
      <p>{zh ? '夏洛特本地餐饮食品批发商，品类齐全、供货稳定、服务实在。' : 'A Charlotte foodservice distributor built around selection, consistency and practical service.'}</p>
    </div>
    <div class="footer-column"><span>{zh ? '导航' : 'Navigate'}</span><a href={href('/products/')}>{zh ? '产品目录' : 'Products'}</a><a href={href('/apply/')}>{zh ? '申请开户' : 'Apply for an account'}</a><a href={href('/delivery/')}>{zh ? '配送安排' : 'Delivery'}</a><a href={href('/industries/')}>{zh ? '服务客户' : 'Who we serve'}</a><a href={href('/contact/')}>{zh ? '联系我们' : 'Contact'}</a></div>
    <div class="footer-column"><span>{zh ? '目录' : 'Catalog'}</span><a href={href('/products/catalog/')}>{zh ? '搜索产品' : 'Search products'}</a><a href={href('/cart/')}>{zh ? '购物车 / 下单' : 'Order cart'}</a><a href="/catalog/van-harvest-product-catalog.pdf" target="_blank" rel="noopener noreferrer">{zh ? '下载 PDF 目录 ↗' : 'Download PDF ↗'}</a><a href={href('/careers/')}>{zh ? '招聘' : 'Careers'}</a><a href={href('/suppliers/')}>{zh ? '供应商合作' : 'Suppliers'}</a><a href={href('/privacy/')}>{zh ? '隐私政策' : 'Privacy'}</a><a href={href('/terms/')}>{zh ? '网站条款' : 'Terms'}</a></div>
    <div class="footer-column"><span>{zh ? '夏洛特办公室' : 'Charlotte office'}</span><a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a><a class="footer-email" href={`mailto:${contact.officeEmail}`}>{contact.officeEmail}</a><a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{contact.address} ↗</a><div class="footer-map"><iframe src={contact.mapsEmbedUrl} title={zh ? 'Van Harvest 办公室地图' : 'Van Harvest office map'} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{zh ? '在 Google 地图中打开 ↗' : 'Open Google Maps ↗'}</a></div></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Van Harvest LLC</span><span>{zh ? '餐饮食品批发 · 北卡夏洛特' : 'Wholesale food distribution · Charlotte, NC'}</span><a href="#main">{zh ? '回到顶部 ↑' : 'Back to top ↑'}</a></div>
</footer>
