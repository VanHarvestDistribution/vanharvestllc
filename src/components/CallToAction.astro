---
import { contact } from '@/data/site';
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
---
<section class="cta-band">
  <div class="shell cta-grid reveal">
    <h2>{zh ? '申请开户，开始采购' : 'Open an account to start ordering'}</h2>
    <div class="cta-copy">
      <p>
        {zh
          ? '新客户货到付款（COD），合作满一个月可申请账期。24 小时电话或短信下单，每次最低起送额 $500。'
          : 'New accounts start on COD; payment terms available after one month. Order 24/7 by phone or text with a $500 minimum per delivery.'}
      </p>
      <div class="cta-actions">
        <a class="button" href={`${prefix}/apply/`}>{zh ? '申请开户 →' : 'Apply for an account →'}</a>
        <a class="text-link" href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>
