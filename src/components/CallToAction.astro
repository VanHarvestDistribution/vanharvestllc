---
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
---
<section class="cta-band"><div class="shell cta-grid reveal"><p class="eyebrow">{zh ? '准备开始采购？' : 'Ready to source?'}</p><h2>{zh ? <>让你的<br /><em>厨房持续运转。</em></> : <>Let’s keep your<br /><em>kitchen moving.</em></>}</h2><div class="cta-copy"><p>{zh ? '在目录中查找产品，或联系 Van Harvest 团队讨论你的餐饮供应需求。' : 'Find an item in our catalog or talk with the Van Harvest team about your foodservice needs.'}</p><a class="text-link" href={`${prefix}/contact`}>{zh ? '联系我们 →' : 'Contact our team →'}</a></div></div></section>
