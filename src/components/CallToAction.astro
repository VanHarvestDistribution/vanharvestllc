---
import { contact } from '@/data/site';
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
---
<section class="cta-band"><div class="shell cta-grid reveal"><p class="eyebrow">{zh ? '开始合作' : 'Ready to work together?'}</p><h2>{zh ? <>为你的厨房，<br /><em>准备下一单。</em></> : <>Set up your account,<br /><em>then source with confidence.</em></>}</h2><div class="cta-copy"><p>{zh ? '申请批发账户，了解适合你业务的产品选择和服务方式。' : 'Apply for a wholesale account and connect with the Van Harvest team about your foodservice needs.'}</p><div class="cta-actions"><a class="button" href={`${prefix}/apply`}>{zh ? '申请开户 →' : 'Apply for an account →'}</a><a class="text-link" href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a></div></div></div></section>
