---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RelatedProducts from '@/components/RelatedProducts.astro';
import { productImageFor, categoryPlaceholder } from '@/data/productImages';
import { absoluteUrl } from '@/data/seo';

interface Props { product: any; category: any; lang?: 'en' | 'zh'; localized?: boolean }
const { product, category, lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const categoryName = zh ? category.nameZh : category.name;

const storageMap: Record<string, { en: string; zh: string }> = {
  frozen: { en: 'Frozen', zh: '冷冻' },
  refrigerated: { en: 'Refrigerated', zh: '冷藏' },
  dry: { en: 'Shelf-stable', zh: '常温' }
};

const storageDisplay = product.storage && storageMap[product.storage]
  ? (zh ? storageMap[product.storage].zh : storageMap[product.storage].en)
  : '—';

const realImage = productImageFor(product.id);
const placeholder = categoryPlaceholder(product.category);
const imageSrc = realImage || placeholder;
const imageAlt = realImage
  ? `${product.name} ${zh ? '产品实拍' : 'product photo'}`
  : `${categoryName} ${zh ? '品类占位图' : 'category placeholder'}`;

const primaryTitle = zh ? (product.nameZh || product.name) : product.name;
const subtitle = zh ? product.name : (product.nameZh || '');

// Extract brand from name when recognizable
const brandMatch = product.name.match(/\b(LKK|Lee Kum Kee|Huy Fong|Nongshim|Master Kong|KSF|Darnel|Reynolds|Smithfield|Tyson)\b/i);
const brandName = brandMatch ? brandMatch[1] : undefined;

const productJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: primaryTitle,
  description: `${primaryTitle} (${product.id}) - Van Harvest wholesale ${categoryName}.`,
  sku: product.id,
  mpn: product.id,
  category: category.name,
  image: absoluteUrl(imageSrc) || imageSrc
};
if (brandName) {
  productJsonLd.brand = { '@type': 'Brand', name: brandName };
}

const pageTitle = `${primaryTitle} (Item ${product.id}) | ${categoryName} | Van Harvest`;
const pageDescription = `${primaryTitle} (Item ${product.id}), ${categoryName}. ${zh ? '申请开户查看批发价格与配送安排。' : 'Apply for a wholesale account to see pricing and delivery.'}`;
---
<BaseLayout title={pageTitle} description={pageDescription} active="/products" lang={lang} jsonLd={productJsonLd}>
  <!-- Clean solid-color hero without confusing text-covered background photos -->
  <section class="product-detail-clean-hero">
    <div class="shell">
      <p class="breadcrumb">
        <a href={`${prefix}/products`}>{zh ? '产品目录' : 'Products'}</a>
        <span>/</span>
        <a href={`${prefix}/products/${category.key}`}>{categoryName}</a>
        <span>/</span>
        <span>{zh ? `编号 ${product.id}` : `Item ${product.id}`}</span>
      </p>

      <p class="eyebrow eyebrow-light">{categoryName} · ITEM #{product.id}</p>
      <h1>{primaryTitle}</h1>
      {subtitle && <p class={zh ? 'detail-en-sub' : 'detail-zh-sub'}>{subtitle}</p>}
    </div>
  </section>

  <!-- Main content area with clear specs and natural non-hero product photo -->
  <section class="product-detail-main">
    <div class="shell product-detail-main-grid">
      <div class="product-detail-photo-card">
        {realImage ? (
          <img src={realImage} alt={imageAlt} loading="eager" />
        ) : (
          <div class="product-detail-fallback-badge" role="img" aria-label={imageAlt}>
            <span style="font-size:24px">VH</span>
            <span>{categoryName}</span>
          </div>
        )}
      </div>

      <div class="product-detail-copy-wrap">
        <div class="product-specs-list">
          <div class="product-spec-row">
            <small>{zh ? '产品编号' : 'Item #'}</small>
            <strong>{product.id}</strong>
          </div>
          <div class="product-spec-row">
            <small>{zh ? '所属品类' : 'Department'}</small>
            <strong>{categoryName}</strong>
          </div>
          <div class="product-spec-row">
            <small>{zh ? '包装规格' : 'Pack size'}</small>
            <strong>{product.packSize || (zh ? '标准餐饮装' : 'Foodservice pack')}</strong>
          </div>
          <div class="product-spec-row">
            <small>{zh ? '存储温层' : 'Storage'}</small>
            <strong>{storageDisplay}</strong>
          </div>
        </div>

        <p class="lead" style="margin-bottom:28px">
          {zh ? '面向专业厨房与商业餐饮采购，支持整箱订购与冷链区域配送。' : 'Available for commercial foodservice accounts with dependable regional delivery.'}
        </p>

        <div class="hero-actions">
          <a class="button" href={`${prefix}/apply`}>{zh ? '申请开户查看价格 →' : 'Apply for an account to see pricing →'}</a>
          <a class="button button-outline" style="color:var(--navy);border-color:var(--line)" href={`${prefix}/contact`}>{zh ? '联系销售 →' : 'Contact sales →'}</a>
        </div>
      </div>
    </div>
  </section>

  <RelatedProducts product={product} category={category} lang={lang} localized={localized} />
</BaseLayout>
