---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact, categories } from '@/data/site';
import { categoryUploadedImages } from '@/data/categoryUploadedImages';
interface Props { product: any; category: any; lang: 'en'|'zh'; }
const { product, category, lang } = Astro.props;
const zh = lang === 'zh';
const storage = product.storage === 'frozen' ? (zh ? '冷冻 / Frozen' : 'Frozen / 冷冻') : product.storage === 'refrigerated' ? (zh ? '新鲜或冷藏 / Fresh or refrigerated' : 'Fresh or refrigerated / 新鲜或冷藏') : (zh ? '常温 / Dry' : 'Dry / 常温');
const title = `${product.name}${product.nameZh ? ` / ${product.nameZh}` : ''} | Item ${product.id}`;
const description = `${zh ? 'Van Harvest 产品详情' : 'Van Harvest product detail'}: ${product.name}${product.nameZh ? ` / ${product.nameZh}` : ''}.`;
const productImage = `/images/products/uploaded/${(categoryUploadedImages[category.key] || [])[0] || ''}`;
---
<BaseLayout title={title} description={description} active="/products" lang={lang} ogImage={productImage || category.image}><section class="category-detail-hero"><div class="category-detail-media"><img src={productImage || category.image} alt={`${product.name} product photo`} /></div><div class="category-detail-shade"></div><div class="shell category-detail-inner"><p class="breadcrumb"><a href={`/${lang}/products`}>{zh ? '产品目录' : 'Product catalog'}</a><span>/</span>{category.name}<span>/</span>Item {product.id}</p><div class="category-detail-copy"><p class="eyebrow eyebrow-light">Item {product.id} · {category.name}</p><h1>{product.name}</h1>{product.nameZh && <p class="detail-zh">{product.nameZh}</p>}<div class="detail-meta-grid"><div class="detail-meta"><small>Item #</small><strong>{product.id}</strong></div><div class="detail-meta"><small>{zh ? '温层 / Storage' : 'Storage / 温层'}</small><strong>{storage}</strong></div><div class="detail-meta"><small>{zh ? '包装 / Pack' : 'Pack / 包装'}</small><strong>{product.packSize || (zh ? '请向销售确认' : 'Confirm with sales')}</strong></div></div></div></div></section><section class="product-detail-body"><div class="shell product-detail-grid"><div class="product-placeholder"><img src={productImage || category.image} alt={`${product.name} product photo`} loading="lazy" /></div><div class="product-detail-copy"><p class="eyebrow">{zh ? '产品信息' : 'Product information'}</p><h2>{zh ? '为专业厨房准备。' : 'Built for the professional kitchen.'}</h2><p class="detail-zh">{product.nameZh || (zh ? '中文名称待补充' : '')}</p><p class="detail-description">{zh ? '本产品属于 Van Harvest 批发目录。库存、包装和替代品可能变化，请联系办公室确认。网站不显示价格。' : 'This item is part of the Van Harvest wholesale catalog. Availability, pack details and substitutions can change; contact the office for current guidance. No pricing is shown online.'}</p><div class="detail-actions"><a class="button" href={`/${lang}/apply`}>{zh ? '申请开户 →' : 'Apply for an account →'}</a><a class="button button-outline" href={`mailto:${contact.officeEmail}`}>{zh ? '联系销售 →' : 'Contact sales →'}</a></div></div></div></section></BaseLayout>
