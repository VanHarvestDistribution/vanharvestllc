---
import products from '@/data/products.json';
import { categories } from '@/data/site';

const counts = products.reduce<Record<string, number>>((result, product) => {
  result[product.category] = (result[product.category] || 0) + 1;
  return result;
}, {});
---
<section class="category-gallery" aria-labelledby="shop-by-category">
  <div class="shell">
    <div class="category-gallery-heading reveal">
      <div><p class="eyebrow">Shop by category</p><h2 id="shop-by-category">Start with<br /><em>what you serve.</em></h2></div>
      <p>Every department opens to a dedicated category page with a short, useful selection of Featured Products from the Van Harvest item list.</p>
    </div>
    <div class="category-gallery-grid">
      {categories.map((category) => <a class="category-gallery-card reveal" href={`/products/${category.key}`} aria-label={`Explore ${category.name}`}>
        <div class="category-gallery-image"><img src={category.image} alt={`${category.name} wholesale selection`} loading="lazy" /><span>{category.index}</span></div>
        <div class="category-gallery-copy"><h3>{category.name}</h3><p>{counts[category.key].toLocaleString()} catalog items</p></div>
      </a>)}
    </div>
  </div>
</section>
