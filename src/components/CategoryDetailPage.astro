---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
import productsData from '@/data/products.json';
import { productImageFor } from '@/data/productImages';

interface Props { category: any; lang?: 'en' | 'zh'; localized?: boolean }
const { category, lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const products = (productsData as any[]).filter((product) => product.category === category.key);

/**
 * Treat colour, size and package variants as one concept in the curated showcase.
 * The full catalog remains the place to compare each individual variant.
 */
const productConcept = (product: any) => product.name
  .toLowerCase()
  .replace(/\([^)]*\)/g, ' ')
  .replace(/\b(?:white|red|green|yellow|black|brown|purple|orange|pink|gold|silver|clear|large|small|medium|mini|jumbo|extra[-\s]?large|xl|xxl|xs|[sml])\b/g, ' ')
  .replace(/\b\d+(?:\.\d+)?\s*(?:oz|lb|lbs|g|kg|ml|l|ct|pc|pcs|pk|pkg|case|cs)\b/g, ' ')
  .replace(/\b\d+\b/g, ' ')
  .replace(/[^a-z]+/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const featuredOrder: any[] = category.featuredIds
  .map((id: string) => products.find((product) => product.id === id))
  .filter(Boolean);
const showcaseCandidates = [...featuredOrder, ...products.filter((product) => !featuredOrder.some((featured) => featured.id === product.id))];
const seenConcepts = new Set<string>();
const usedImages = new Set<string>();
const featured: Array<{ product: any; image?: string }> = [];
for (const product of showcaseCandidates) {
  const concept = productConcept(product) || product.id;
  if (seenConcepts.has(concept)) continue;
  seenConcepts.add(concept);
  const source = productImageFor(product.id);
  const image = source && !usedImages.has(source) ? source : undefined;
  if (image) usedImages.add(image);
  featured.push({ product, image });
  if (featured.length === 12) break;
}

const name = zh ? category.nameZh : category.name;
const title = zh ? `${name}批发产品 | Van Harvest` : `${category.name} Wholesale Products | Van Harvest`;
const description = zh ? `浏览 Van Harvest ${name}的精选产品、中英文名称、包装与温层信息。` : `Browse featured Van Harvest ${category.name.toLowerCase()} products with bilingual names, pack and storage details.`;
---
<BaseLayout title={title} description={description} active="/products" lang={lang}>
  <section class="category-detail-hero">
    <div class="category-detail-media"><img src={category.image} alt={`${name} ${zh ? '产品分类' : 'wholesale category'}`} /></div>
    <div class="category-detail-shade"></div>
    <div class="shell category-detail-inner">
      <p class="breadcrumb"><a href={`${prefix}/products`}>{zh ? '产品目录' : 'Product catalog'}</a><span>/</span>{name}</p>
      <div class="category-detail-copy">
        <p class="eyebrow eyebrow-light">{name}</p>
        <h1>{name}<br /><em>{zh ? '为专业厨房准备。' : 'for the professional kitchen.'}</em></h1>
        <p>{zh ? category.shortZh : category.short}</p>
        <a class="button" href={`${prefix}/products/catalog?category=${category.key}#catalog`}>{zh ? '搜索本类产品 →' : 'Search this category →'}</a>
      </div>
    </div>
  </section>

  <section class="featured-products">
    <div class="shell">
      <div class="featured-products-heading">
        <div><p class="eyebrow">{zh ? '精选产品' : 'Featured products'}</p><h2>{zh ? <>精选<br /><em>产品。</em></> : <>Featured<br /><em>products.</em></>}</h2></div>
        <p>{zh ? '精选不同产品类型，方便快速浏览；颜色、尺寸和包装变体可在完整目录中比较。' : 'A curated mix of distinct product types. Compare color, size and package variations in the full catalog.'}</p>
      </div>
      <div class="featured-product-grid">
        {featured.map(({ product, image }) => (
          <a class="featured-product-card featured-product-card-with-image" href={`${prefix}/products/${category.key}/${product.id}`}>
            {image ? <div class="featured-product-thumb"><img src={image} alt={`${product.name} product photo`} loading="lazy" /></div> : <div class="featured-product-thumb featured-product-placeholder" role="img" aria-label={zh ? `${name} 分类产品` : `${name} category item`}></div>}
            <div><small>Item {product.id} · {product.storage || '—'}</small><h3>{product.name}</h3>{product.nameZh && <p class="product-zh">{product.nameZh}</p>}{product.packSize && <p>{product.packSize}</p>}</div>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
      <div class="featured-products-footer"><p>{zh ? `可在完整目录中按产品编号、英文名或中文名搜索全部${name}。` : `Search the full ${category.name} selection by Item #, English name or Chinese name.`}</p><a class="text-link" href={`${prefix}/products/catalog?category=${category.key}#catalog`}>{zh ? '查看完整品类 →' : 'View full category →'}</a></div>
    </div>
  </section>
  <CallToAction lang={lang} localized={localized} />
</BaseLayout>
