---
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const departments = [
  { value: 'sales', label: zh ? '销售' : 'Sales', copy: zh ? '产品与开户咨询' : 'Product and account inquiries' },
  { value: 'customer-service', label: zh ? '客服' : 'Customer Service', copy: zh ? '当前订单与服务问题' : 'Current order and service questions' },
  { value: 'purchasing', label: zh ? '采购' : 'Purchasing', copy: zh ? '供应商与产品沟通' : 'Vendor and product conversations' },
  { value: 'hr', label: zh ? '人事' : 'Human Resources', copy: zh ? '招聘与工作咨询' : 'Employment and workplace inquiries' }
];
---
<div class="department-form-wrap">
  <div class="form-heading">
    <h3>{zh ? '在线留言' : 'Send a message'}</h3>
    <p>{zh ? <>所有留言都会发送至 ordersvhd@gmail.com，办公室团队会按部门处理。</> : <>All messages are sent to ordersvhd@gmail.com and routed to the appropriate team.</>}</p>
  </div>
  <form class="department-form" data-unified-form data-form-kind="contact" data-lang={lang} action="https://formsubmit.co/ajax/ordersvhd@gmail.com" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_subject" value="Van Harvest contact form" />
    <input type="hidden" name="_captcha" value="true" />
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-trap" />
    <label><span>{zh ? '部门' : 'Department'}</span><select name="department" required>{departments.map((department) => <option value={department.value}>{department.label}</option>)}</select></label>
    <div class="form-grid"><label><span>{zh ? '姓名' : 'Your name'}</span><input name="name" autocomplete="name" required /></label><label><span>{zh ? '公司' : 'Company'}</span><input name="company" autocomplete="organization" /></label></div>
    <div class="form-grid"><label><span>{zh ? '邮箱' : 'Email'}</span><input type="email" name="email" autocomplete="email" required /></label><label><span>{zh ? '电话' : 'Phone'}</span><input type="tel" name="phone" autocomplete="tel" /></label></div>
    <label><span>{zh ? '留言' : 'Message'}</span><textarea name="message" rows="5" required></textarea></label>
    <div class="form-actions"><button class="button" type="submit">{zh ? '发送 →' : 'Send →'}</button><span class="form-status" data-form-status aria-live="polite"></span></div>
  </form>
</div>
