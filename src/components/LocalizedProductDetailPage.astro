---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categories, contact } from '@/data/site';
import { absoluteUrl } from '@/data/seo';

interface Props {
  product: { id: string; name: string; nameZh?: string; category: string; storage?: string; image: string };
  category?: any;
  lang?: 'en' | 'zh';
  localized?: boolean;
}

const { product, category: passedCategory, lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const category = passedCategory || categories.find((c) => c.key === product.category) || { key: product.category, name: product.category, nameZh: product.category };
const primaryName = zh && product.nameZh ? product.nameZh : product.name;
const secondaryName = zh && product.nameZh ? product.name : (product.nameZh || '');
const storageMap: Record<string, string> = { frozen: zh ? '冷冻' : 'Frozen', refrigerated: zh ? '冷藏' : 'Refrigerated' };
const storage = product.storage ? storageMap[product.storage] || product.storage : '';
const title = zh ? `${primaryName} | Van Harvest 万昌` : `${primaryName} | Van Harvest`;
const description = zh ? `查看 Van Harvest 万昌夏洛特食品批发目录中的${primaryName}，了解产品图片、编号、品类和温层信息，方便餐馆采购核对。` : `View ${product.name}, Item #${product.id}, from Van Harvest LLC, a wholesale food distributor serving Charlotte restaurants.`;
const imageUrl = absoluteUrl(product.image);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Product', name: product.name, image: imageUrl ? [imageUrl] : undefined, sku: product.id, category: category.name, brand: undefined, description };
---
<BaseLayout title={title} description={description} active="/products" lang={lang} ogImage={product.image} jsonLd={jsonLd}>
  <main class="product-detail-page">
    <section class="product-detail-hero">
      <div class="shell">
        <p class="breadcrumb">
          <a href={`${prefix}/products/`}>{zh ? '产品目录' : 'Products'}</a>
          <span>/</span>
          <a href={`${prefix}/products/${category.key}/`}>{zh ? category.nameZh : category.name}</a>
          <span>/</span>
          {product.id}
        </p>
        <h1>{primaryName}</h1>
        {secondaryName && <p class="product-detail-subtitle">{secondaryName}</p>}
      </div>
    </section>
    <section class="product-detail-body">
      <div class="shell product-detail-grid">
        <div class="product-detail-photo">
          <img src={product.image} alt={zh ? `${primaryName} 产品图片` : `${product.name} wholesale product photo`} loading="eager" />
        </div>
        <div class="product-detail-copy">
          <p class="product-detail-item">{zh ? '产品编号' : 'Item #'} <strong>{product.id}</strong></p>
          <dl class="product-detail-specs">
            <div>
              <dt>{zh ? '品类' : 'Department'}</dt>
              <dd>{zh ? category.nameZh : category.name}</dd>
            </div>
            {storage && (
              <div>
                <dt>{zh ? '温层' : 'Storage'}</dt>
                <dd>{storage}</dd>
              </div>
            )}
          </dl>
          <div class="detail-actions">
            <a class="button button-gold" href={`${prefix}/apply/`}>{zh ? '申请开户查看价格' : 'Apply for an account to see pricing'}</a>
            <a class="button button-outline-dark" href={`tel:${contact.phoneHref}`}>{zh ? `致电 ${contact.phoneDisplay}` : `Call ${contact.phoneDisplay}`}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
