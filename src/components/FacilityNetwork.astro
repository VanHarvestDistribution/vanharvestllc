---
import { facilityImages } from '@/data/site';
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const facilities = [
  { image: facilityImages.warehouse, label: '29,000 SF', title: zh ? '食品仓库' : 'Food warehouse', copy: zh ? '位于 Charlotte 的食品批发仓库，为多品类餐饮采购提供收货、存储与备货空间。' : 'A 29,000-square-foot Charlotte warehouse built for organized receiving, storage and foodservice picking.' },
  { image: facilityImages.coldStorage, label: zh ? '冷链处理' : 'Cold-chain ready', title: zh ? '冷库与冷链' : 'Cold storage', copy: zh ? '新鲜、冷冻与温控产品由不同温层的运营流程支持。' : 'Fresh, frozen and temperature-sensitive products are supported through distinct cold-chain workflows.' },
  { image: facilityImages.distribution, label: zh ? '四个配送区域' : 'Four delivery regions', title: zh ? '配送运营' : 'Distribution operations', copy: zh ? '当前路线服务 North Carolina、South Carolina、Atlanta, GA 和 Virginia。' : 'Current routes serve North Carolina, South Carolina, Atlanta, GA and Virginia.' }
];
---
<section class="facility-network" aria-labelledby="facility-title"><div class="shell"><div class="facility-heading"><div><p class="eyebrow">{zh ? '设施与配送网络' : 'Facilities & delivery network'}</p><h2 id="facility-title">{zh ? <>从仓库到<br /><em>专业厨房。</em></> : <>From warehouse<br />to <em>working kitchens.</em></>}</h2></div><p>{zh ? 'Van Harvest 将食品仓储、冷链处理和区域配送串联为一条可靠的供应链。' : 'Van Harvest connects food warehousing, cold-chain handling and regional delivery in one dependable supply chain.'}</p></div><div class="facility-grid">{facilities.map((facility) => <article class="facility-card"><div class="facility-image"><img src={facility.image} alt={facility.title} loading="lazy" /></div><div class="facility-card-meta"><p class="facility-label">{facility.label}</p><h3>{facility.title}</h3><p>{facility.copy}</p></div></article>)}</div></div></section>
