---
import { contact } from '@/data/site';

interface Props {
  lang?: 'en' | 'zh';
  localized?: boolean;
}

const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const labels = zh
  ? {
      close: '关闭产品详情',
      loading: '正在加载产品信息…',
      unavailable: '暂时无法加载该产品信息。',
      englishName: '英文名称',
      chineseName: '中文名称',
      item: '产品编号',
      pack: '包装规格',
      storage: '温层',
      apply: '申请开户查看价格',
      contact: '联系销售',
      frozen: '冷冻',
      refrigerated: '冷藏',
      photoAlt: '产品实拍图'
    }
  : {
      close: 'Close product details',
      loading: 'Loading product details…',
      unavailable: 'This product detail is unavailable right now.',
      englishName: 'English name',
      chineseName: 'Chinese name',
      item: 'Item #',
      pack: 'Pack size',
      storage: 'Storage',
      apply: 'Apply for an account to see pricing',
      contact: 'Contact sales',
      frozen: 'Frozen',
      refrigerated: 'Refrigerated',
      photoAlt: 'Product photo'
    };
---
<div
  class="product-drawer-layer"
  data-product-drawer
  data-prefix={prefix}
  data-sales-email={contact.salesEmail}
  data-labels={JSON.stringify(labels)}
  hidden
>
  <div class="product-drawer-scrim" data-drawer-scrim></div>
  <aside class="product-drawer" role="dialog" aria-modal="true" aria-labelledby="product-drawer-title" tabindex="-1">
    <button class="product-drawer-close" type="button" data-drawer-close aria-label={labels.close}>×</button>
    <div class="product-drawer-loading" data-drawer-loading>{labels.loading}</div>
    <div class="product-drawer-content" data-drawer-content hidden>
      <div class="product-drawer-photo" data-drawer-photo hidden>
        <img data-drawer-image alt="" loading="lazy" />
      </div>
      <p class="eyebrow" data-drawer-item></p>
      <div class="product-drawer-names">
        <p class="product-drawer-name-label" data-drawer-primary-label></p>
        <h2 id="product-drawer-title" data-drawer-primary-name></h2>
        <p class="product-drawer-name-label" data-drawer-secondary-label></p>
        <p class="product-drawer-secondary" data-drawer-secondary-name></p>
      </div>
      <dl class="product-drawer-specs">
        <div><dt>{labels.item}</dt><dd data-drawer-id></dd></div>
        <div data-drawer-pack-row hidden><dt>{labels.pack}</dt><dd data-drawer-pack></dd></div>
        <div data-drawer-storage-row hidden><dt>{labels.storage}</dt><dd data-drawer-storage></dd></div>
      </dl>
      <div class="product-drawer-actions">
        <a class="button" data-drawer-apply href={`${prefix}/apply`}>{labels.apply}</a>
        <a class="button button-outline" data-drawer-contact href={`mailto:${contact.salesEmail}`}>{labels.contact}</a>
      </div>
    </div>
  </aside>
</div>

<script is:inline>
  (() => {
    if (window.__vhProductDrawerInitialized) return;
    window.__vhProductDrawerInitialized = true;

    const root = document.querySelector('[data-product-drawer]');
    if (!root) return;

    const labels = JSON.parse(root.dataset.labels || '{}');
    const salesEmail = root.dataset.salesEmail || '';
    const panel = root.querySelector('.product-drawer');
    const scrim = root.querySelector('[data-drawer-scrim]');
    const closeButton = root.querySelector('[data-drawer-close]');
    const loading = root.querySelector('[data-drawer-loading]');
    const content = root.querySelector('[data-drawer-content]');
    const photo = root.querySelector('[data-drawer-photo]');
    const image = root.querySelector('[data-drawer-image]');
    const item = root.querySelector('[data-drawer-item]');
    const primaryLabel = root.querySelector('[data-drawer-primary-label]');
    const primaryName = root.querySelector('[data-drawer-primary-name]');
    const secondaryLabel = root.querySelector('[data-drawer-secondary-label]');
    const secondaryName = root.querySelector('[data-drawer-secondary-name]');
    const id = root.querySelector('[data-drawer-id]');
    const packRow = root.querySelector('[data-drawer-pack-row]');
    const pack = root.querySelector('[data-drawer-pack]');
    const storageRow = root.querySelector('[data-drawer-storage-row]');
    const storage = root.querySelector('[data-drawer-storage]');
    const contactLink = root.querySelector('[data-drawer-contact]');

    let previousTrigger = null;

    const getCatalog = () => {
      if (!window.__vhCatalogPromise) {
        window.__vhCatalogPromise = fetch('/data/catalog.json', { credentials: 'same-origin' })
          .then((response) => {
            if (!response.ok) throw new Error(`Catalog request failed: ${response.status}`);
            return response.json();
          });
      }
      return window.__vhCatalogPromise;
    };

    const setQueryItem = (itemId) => {
      const url = new URL(window.location.href);
      if (itemId) url.searchParams.set('item', itemId);
      else url.searchParams.delete('item');
      history.replaceState({ item: itemId || null }, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const showLayer = () => {
      root.hidden = false;
      document.body.classList.add('product-drawer-open');
      requestAnimationFrame(() => root.classList.add('is-open'));
    };

    const renderProduct = (product) => {
      const isZh = document.documentElement.lang === 'zh-CN';
      const primary = isZh ? (product.nameZh || product.name) : product.name;
      const secondary = isZh ? product.name : product.nameZh;
      const storageText = product.storage === 'frozen'
        ? labels.frozen
        : product.storage === 'refrigerated'
          ? labels.refrigerated
          : '';

      item.textContent = `${labels.item} · ${product.id}`;
      primaryLabel.textContent = isZh ? labels.chineseName : labels.englishName;
      primaryName.textContent = primary || product.id;
      secondaryLabel.textContent = secondary ? (isZh ? labels.englishName : labels.chineseName) : '';
      secondaryName.textContent = secondary || '';
      secondaryName.hidden = !secondary;
      secondaryLabel.hidden = !secondary;
      id.textContent = product.id;

      packRow.hidden = !product.packSize;
      pack.textContent = product.packSize || '';
      storageRow.hidden = !storageText;
      storage.textContent = storageText;

      photo.hidden = !product.image;
      if (product.image) {
        image.src = product.image;
        image.alt = `${primary || product.id} ${labels.photoAlt}`;
      } else {
        image.removeAttribute('src');
        image.alt = '';
      }

      const subject = encodeURIComponent(`${labels.item} ${product.id} — ${product.name || product.nameZh || ''}`);
      contactLink.href = `mailto:${salesEmail}?subject=${subject}`;
      loading.style.display = 'none';
      content.hidden = false;
      panel.focus({ preventScroll: true });
    };

    const showUnavailable = () => {
      loading.textContent = labels.unavailable;
      loading.style.display = '';
      content.hidden = true;
      panel.focus({ preventScroll: true });
    };

    const openById = async (itemId, trigger = null) => {
      if (!itemId) return;
      previousTrigger = trigger || document.activeElement;
      loading.textContent = labels.loading;
      loading.style.display = '';
      content.hidden = true;
      showLayer();
      setQueryItem(itemId);

      try {
        const products = await getCatalog();
        const product = products.find((entry) => String(entry.id) === String(itemId));
        if (!product) return showUnavailable();
        renderProduct(product);
      } catch (_) {
        showUnavailable();
      }
    };

    const closeDrawer = () => {
      if (root.hidden) return;
      root.classList.remove('is-open');
      document.body.classList.remove('product-drawer-open');
      window.setTimeout(() => { root.hidden = true; }, 180);
      setQueryItem(null);
      if (previousTrigger && typeof previousTrigger.focus === 'function') {
        previousTrigger.focus({ preventScroll: true });
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-product-open]') : null;
      if (target) {
        event.preventDefault();
        openById(target.getAttribute('data-product-id'), target);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !root.hidden) {
        event.preventDefault();
        closeDrawer();
        return;
      }
      if ((event.key === 'Enter' || event.key === ' ') && event.target instanceof Element) {
        const target = event.target.closest('[data-product-open]');
        if (target) {
          event.preventDefault();
          openById(target.getAttribute('data-product-id'), target);
        }
      }
    });

    closeButton.addEventListener('click', closeDrawer);
    scrim.addEventListener('click', closeDrawer);

    const directItem = new URLSearchParams(window.location.search).get('item');
    if (directItem) openById(directItem);

    window.__vhOpenProductDrawer = openById;
  })();
</script>
