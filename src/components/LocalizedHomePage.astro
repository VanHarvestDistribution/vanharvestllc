---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
import HomeCatalogMarquee from '@/components/HomeCatalogMarquee.astro';
import products from '@/data/products.json';
import { categories, heroImage } from '@/data/site';
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const heroSlides = [heroImage, categories[0].image, categories[1].image, categories[2].image];
---
<BaseLayout title={zh ? 'Van Harvest | 夏洛特食品批发供应' : 'Van Harvest Distribution | Wholesale Food in Charlotte'} description={zh ? '为夏洛特餐馆、超市和专业厨房提供食品批发供应。' : "Explore Van Harvest Distribution's wholesale food catalog for Charlotte foodservice teams."} active="/" lang={lang} ogImage={heroImage}>
<section class="home-hero"><div class="home-hero-slideshow" aria-label={zh ? 'Van Harvest 食品和配送图片' : 'Van Harvest food and distribution imagery'}>{heroSlides.map((image, index) => <div class="home-hero-slide" style={`background-image:url('${image}')`} aria-hidden={index !== 0}></div>)}</div><div class="home-hero-shade"></div><div class="shell hero-inner"><div class="hero-topline"><span>{zh ? '食品批发供应' : 'Wholesale food distribution'}</span><span>Charlotte, North Carolina</span></div><div class="hero-copy reveal"><p class="eyebrow">{zh ? '为专业厨房服务' : 'Built for professional kitchens'}</p><h1>{zh ? <>好食材，来自<br /><em>可靠的供应。</em></> : <>Good food starts<br />with a <em>reliable source.</em></>}</h1><div class="hero-copy-bottom"><p>{zh ? '为餐馆、超市和餐饮团队提供新鲜、冷冻及常温食品。' : 'From fresh produce and proteins to pantry staples and restaurant supplies, Van Harvest brings a broad catalog together for foodservice teams.'}</p><a class="button" href={`${prefix}/products`}>{zh ? '浏览产品目录 →' : 'Explore our catalog →'}</a></div></div><div class="hero-bottom"><div class="hero-stats"><div><strong>{products.length.toLocaleString()}+</strong><span>{zh ? '目录产品' : 'catalog items'}</span></div><div><strong>CLT</strong><span>{zh ? '服务基地' : 'home base'}</span></div><div><strong>TBD</strong><span>{zh ? '配送范围' : 'delivery coverage'}</span></div></div><span class="scroll-note">{zh ? '向下浏览 ↓' : 'Scroll to explore ↓'}</span></div></div></section>
<section class="home-intro"><div class="shell split-heading reveal"><div><p class="eyebrow">{zh ? '一个目录，服务多种厨房。' : 'One catalog. Many kitchens.'}</p><h2>{zh ? <>餐饮供应，<br /><em>用心选择。</em></> : <>Foodservice supply,<br /><em>selected with purpose.</em></>}</h2></div><div class="split-copy"><p>{zh ? 'Van Harvest 是一家位于 Charlotte 的食品批发供应商，为餐馆、超市和便利店提供产品。' : 'Van Harvest is a Charlotte-based wholesale food distributor serving restaurants, supermarkets and convenience stores across the region.'}</p><p>{zh ? '新鲜、冷冻和常温食品通过一个实用的餐饮供应来源协调。' : 'Fresh, frozen and dry goods are coordinated through one practical foodservice source.'}</p><a class="text-link" href={`${prefix}/company`}>{zh ? '了解 Van Harvest →' : 'Meet Van Harvest →'}</a></div></div></section>
<section class="statement"><div class="shell statement-grid reveal"><span>{zh ? '为本地厨房建立信任。' : 'Trust built for local kitchens.'}</span><p><strong>{zh ? '[成立年限待确认]' : '[Years in business to be confirmed]'}</strong> · <strong>{zh ? '[配送区域待确认]' : '[Delivery territory to be confirmed]'}</strong> · {zh ? '冷链产品能力 · 餐馆、亚洲厨房和零售客户。' : 'cold-chain capable assortment · restaurants, Asian kitchens and retailers.'}</p></div></section>
<section class="live-seafood-band"><div class="shell live-seafood-grid reveal"><div><p class="eyebrow eyebrow-light">{zh ? 'Van Harvest 的特色' : 'A Van Harvest difference'}</p><h2>{zh ? <>活海鲜<br /><em>关键时刻有供应。</em></> : <>Live seafood<br /><em>when it matters.</em></>}</h2></div><div><p>{zh ? '联系团队，了解专业厨房的活海鲜供应和季节性采购。' : 'Ask the team about live seafood availability and seasonal sourcing for professional kitchens.'}</p><a class="button" href={`${prefix}/products/seafood`}>{zh ? '探索海鲜 →' : 'Explore seafood →'}</a></div></div></section>
<HomeCatalogMarquee lang={lang} />
<section class="catalog-banner"><div class="shell catalog-banner-grid reveal"><div><p class="eyebrow eyebrow-light">{zh ? '当前产品目录' : 'Current item list'}</p><h2>{zh ? <>下一次采购<br />从<em>目录开始。</em></> : <>Your next order<br />starts with <em>the catalog.</em></>}</h2></div><div class="catalog-banner-copy"><p>{zh ? '在线搜索数字目录，也可以下载完整 PDF，方便采购和厨房计划。' : 'Search the digital catalog for speed, or keep the complete PDF handy for purchasing and kitchen planning.'}</p><div class="catalog-banner-actions"><a class="button" href={`${prefix}/products`}>{zh ? '搜索产品 →' : 'Search products →'}</a><a class="button button-outline" href="/catalog/van-harvest-product-catalog.pdf" target="_blank" rel="noopener noreferrer">{zh ? '下载 PDF ↗' : 'Download PDF ↗'}</a></div></div></div></section>
<CallToAction lang={lang} localized={localized} />
</BaseLayout>
