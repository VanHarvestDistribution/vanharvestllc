---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
import FacilityNetwork from '@/components/FacilityNetwork.astro';
import HomeCatalogMarquee from '@/components/HomeCatalogMarquee.astro';
import products from '@/data/products.json';
import { contact, heroImage, heroImages } from '@/data/site';
import { absoluteUrl } from '@/data/seo';

interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang = 'en', localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const heroSlides = heroImages;
const productCount = products.length.toLocaleString();
const pageDescription = zh
  ? `Van Harvest 万昌位于夏洛特，拥有 100,000 平方英尺仓库，提供 ${productCount}+ 种肉类、蔬果、海鲜、干货与餐饮用品批发，每日配送北卡、南卡，预约配送维吉尼亚与亚特兰大，24 小时电话或短信下单，每次最低 $500。`
  : `Van Harvest LLC operates a 100,000 SF warehouse in Charlotte, supplying ${productCount}+ products across meat, produce, seafood and dry goods with daily NC/SC deliveries, 24/7 ordering and $500 minimum.`;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Van Harvest LLC',
      url: absoluteUrl('/'),
      logo: absoluteUrl('/brand/van-harvest-official.png'),
      telephone: contact.phoneDisplay,
      email: contact.officeEmail,
      description: pageDescription,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '5226 Terminal St',
        addressLocality: 'Charlotte',
        addressRegion: 'NC',
        postalCode: '28208',
        addressCountry: 'US'
      }
    },
    {
      '@type': ['WholesaleStore', 'LocalBusiness'],
      name: 'Van Harvest LLC',
      url: absoluteUrl('/'),
      telephone: contact.phoneDisplay,
      description: pageDescription,
      image: absoluteUrl(heroImage),
      logo: absoluteUrl('/brand/van-harvest-official.png'),
      sameAs: [],
      areaServed: ['North Carolina', 'South Carolina', 'Virginia', 'Georgia'],
      geo: { '@type': 'GeoCoordinates', latitude: 35.2707951, longitude: -80.9019205 },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '5226 Terminal St',
        addressLocality: 'Charlotte',
        addressRegion: 'NC',
        postalCode: '28208',
        addressCountry: 'US'
      },
    }
  ]
};

const pageTitle = zh
  ? '夏洛特亚洲食品批发与配送 | Van Harvest 万昌'
  : 'Asian Food Distributor Charlotte NC | Van Harvest LLC';
---
<BaseLayout title={pageTitle} description={pageDescription} active="/" lang={lang} ogImage={heroImage} jsonLd={organizationJsonLd}>
  <!-- Hero: ONLY place where italic title style is retained -->
  <section class="home-hero">
    <div class="home-hero-slideshow" data-hero-slideshow aria-label={zh ? 'Van Harvest 首页食品主视觉' : 'Van Harvest foodservice hero image'}>
      {heroSlides.map((image, index) => (
        <div class="home-hero-slide" style={`background-image:url('${image}')`} aria-hidden={index !== 0}></div>
      ))}
    </div>
    <div class="home-hero-shade"></div>
    <div class="shell hero-inner">
      <div class="hero-topline">
        <span>{zh ? '夏洛特 100,000 平方英尺食品仓库' : 'Charlotte 100,000 SF warehouse'}</span>
        <span>Charlotte, North Carolina</span>
      </div>
      <div class="hero-copy">
        <h1>
          {zh ? (
            <>Van Harvest 万昌<br /><em>夏洛特亚洲食品批发与配送</em></>
          ) : (
            <>Van Harvest —<br /><em>Wholesale Asian Food Distributor in Charlotte, NC</em></>
          )}
        </h1>
        <div class="hero-copy-bottom">
          <p>
            {zh
              ? '服务北卡、南卡、弗吉尼亚与亚特兰大餐馆、超市与专业厨房。24 小时电话或短信下单，无截单时间，每次最低 $500。'
              : 'Supplying restaurants and markets across NC, SC, VA, and Atlanta. Call or text orders 24/7 with no cutoff time and $500 minimum.'}
          </p>
          <div class="hero-actions">
            <a class="button button-gold" href={`${prefix}/apply/`}>{zh ? '申请开户 →' : 'Apply for an account →'}</a>
            <a class="button button-outline" href={`${prefix}/products/catalog/`}>{zh ? '搜索产品 →' : 'Search products →'}</a>
          </div>
        </div>
      </div>
      <div class="hero-bottom">
        <div class="hero-stats">
          <div><strong>{productCount}+</strong><span>{zh ? '上架产品' : 'catalog items'}</span></div>
          <div><strong>100K</strong><span>{zh ? '平方英尺仓库' : 'SF warehouse'}</span></div>
          <div><strong>4</strong><span>{zh ? '配送区域' : 'delivery regions'}</span></div>
        </div>
        <span class="scroll-note">{zh ? '向下浏览 ↓' : 'Scroll to explore ↓'}</span>
      </div>
    </div>
  </section>

  <!-- Intro: Straightforward plain heading, specific warehouse and daily delivery facts -->
  <section class="home-intro">
    <div class="shell split-heading">
      <div>
        <h2>{zh ? '夏洛特本地仓库与自有车队配送' : 'Charlotte warehouse and fleet delivery'}</h2>
      </div>
      <div class="split-copy">
        <p>
          {zh
            ? 'Van Harvest 位于夏洛特 5226 Terminal St，拥有 100,000 平方英尺食品仓库，自有冷链货车每天配送北卡与南卡，定期配送弗吉尼亚与亚特兰大。'
            : 'Van Harvest operates from 5226 Terminal St in Charlotte with a 100,000 SF warehouse, delivering daily across North Carolina and South Carolina with scheduled routes to Virginia and Atlanta.'}
        </p>
        <p>
          {zh
            ? '九大品类涵盖新鲜及冷冻肉类、蔬果、水产、酱料调味、米面干货、冷冻点心及餐饮用品。新客户货到付款，合作满一个月可申请账期。'
            : 'Nine departments cover fresh and frozen meats, produce, seafood, sauces, dry staples, frozen dim sum and restaurant disposables. COD on start, terms after one month.'}
        </p>
        <a class="text-link" href={`${prefix}/company/`}>{zh ? '了解仓储与配送网络 →' : 'Our warehouse & delivery network →'}</a>
      </div>
    </div>
  </section>
  <section class="seo-topic-links" aria-labelledby="seo-topics-title">
    <div class="shell">
      <h2 id="seo-topics-title">{zh ? '按采购需求了解 Van Harvest 万昌' : 'Find the right wholesale supply route'}</h2>
      <div class="seo-topic-links-grid">
        {[
          ['/charlotte-food-distributor/', zh ? '夏洛特食品批发' : 'Charlotte food distributor'],
          ['/chinese-restaurant-supplier/', zh ? '中餐馆食材供应' : 'Chinese restaurant supplier'],
          ['/nc-sc-food-delivery/', zh ? '北卡南卡食品配送' : 'NC & SC food delivery']
        ].map(([path, label]) => <a href={`${prefix}${path}`}>{label} <span aria-hidden="true">→</span></a>)}
      </div>
    </div>
  </section>

  <HomeCatalogMarquee lang={lang} localized={localized} />

  <!-- Specific regional operational statement -->
  <section class="statement">
    <div class="shell statement-grid">
      <span>{zh ? '配送标准与起送' : 'Delivery schedule & minimums'}</span>
      <p>
        <strong>{zh ? '北卡与南卡每天配送' : 'Daily delivery across NC & SC'}</strong> · <strong>{zh ? '弗吉尼亚与亚特兰大预约配送' : 'Scheduled routes to VA & Atlanta, GA'}</strong> · {zh ? '24 小时电话或短信下单，每次最低起送额 $500。' : '24/7 phone or text ordering, $500 minimum per delivery.'}
      </p>
    </div>
  </section>

  <FacilityNetwork lang={lang} />

  <CallToAction lang={lang} localized={localized} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-slideshow]').forEach((slideshow) => {
    const slides = Array.from(slideshow.querySelectorAll<HTMLElement>('.home-hero-slide'));
    if (slides.length < 2 || slideshow.dataset.animated === 'true') return;

    slideshow.dataset.animated = 'true';
    let activeIndex = 0;
    window.setInterval(() => {
      slides[activeIndex].setAttribute('aria-hidden', 'true');
      activeIndex = (activeIndex + 1) % slides.length;
      slides[activeIndex].setAttribute('aria-hidden', 'false');
    }, 6500);
  });
</script>
