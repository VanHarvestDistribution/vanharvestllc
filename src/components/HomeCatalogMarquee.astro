---
import products from '@/data/products.json';
import { categories } from '@/data/site';
import ResponsivePicture from '@/components/ResponsivePicture.astro';

interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang, localized = false } = Astro.props;
const prefix = localized && lang ? `/${lang}` : '';
const zh = lang === 'zh';
const counts = products.reduce<Record<string, number>>((result, product) => {
  result[product.category] = (result[product.category] || 0) + 1;
  return result;
}, {});
const loop = [...categories, ...categories];
---
<section class="home-catalog-marquee" aria-labelledby="full-catalog-title">
  <div class="shell">
    <div class="marquee-heading reveal">
      <div>
        <h2 id="full-catalog-title">{zh ? '九大品类全部商品' : 'Nine foodservice departments'}</h2>
      </div>
      <div class="marquee-heading-side">
        <p>{zh ? `目前收录 ${products.length.toLocaleString()} 种上架商品，包括肉类禽类、蔬果、水产、酱料、粮油干货、清洁用品及餐饮耗材。` : `Over ${products.length.toLocaleString()} items across proteins, produce, seafood, sauces, dry staples, janitorial supplies and disposables.`}</p>
        <a class="text-link" href={`${prefix}/products/catalog/`}>{zh ? '搜索完整目录 →' : 'Search full catalog →'}</a>
      </div>
    </div>
  </div>

  <div class="marquee-window" aria-label="Nine product departments">
    <div class="marquee-track">
      {loop.map((item, index) => (
        <a class="marquee-card" href={`${prefix}/products/${item.key}/`} aria-label={`${zh ? '浏览' : 'Explore'} ${zh ? item.nameZh : item.name}`} tabindex={index >= categories.length ? -1 : 0}>
          <div class="marquee-card-image">
            <ResponsivePicture src={item.image} alt={`${zh ? item.nameZh : item.name} wholesale selection`} sizes="(max-width: 640px) 320px, 400px" loading="lazy" />
            <i aria-hidden="true">↗</i>
          </div>
          <div class="marquee-card-meta">
            <h3>{zh ? item.nameZh : item.name}</h3>
            <p>{counts[item.key].toLocaleString()} {zh ? '个产品' : 'products'}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="shell marquee-footer">
    <span>{zh ? '悬停暂停 · 点击进入品类' : 'Hover to pause · Click to view department'}</span>
    <span>{categories.length} {zh ? '个品类' : 'departments'}</span>
  </div>
</section>
