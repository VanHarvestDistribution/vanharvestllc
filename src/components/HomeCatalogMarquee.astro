---
import products from '@/data/products.json';
import { categories } from '@/data/site';

const counts = products.reduce<Record<string, number>>((result, product) => {
  result[product.category] = (result[product.category] || 0) + 1;
  return result;
}, {});
const loop = [...categories, ...categories];
---
<section class="home-catalog-marquee" aria-labelledby="full-catalog-title">
  <div class="shell">
    <div class="marquee-heading reveal">
      <div><p class="eyebrow">The full catalog</p><h2 id="full-catalog-title">Nine departments.<br /><em>One dependable source.</em></h2></div>
      <div class="marquee-heading-side"><p>Explore the complete foodservice assortment through imagery first. Hover to pause and enlarge a department; click to open its Featured Products.</p><a class="text-link" href="/products">Search all products →</a></div>
    </div>
  </div>
  <div class="marquee-window" aria-label="Nine product departments">
    <div class="marquee-track">
      {loop.map((item, index) => <a class="marquee-card" href={`/products/${item.key}`} aria-label={`Explore ${item.name}`} tabindex={index >= categories.length ? -1 : 0}>
        <div class="marquee-card-image"><img src={item.image} alt={`${item.name} wholesale selection`} loading="lazy" /><span>{item.index}</span><i aria-hidden="true">↗</i></div>
        <div class="marquee-card-meta"><h3>{item.name}</h3><p>{counts[item.key].toLocaleString()} catalog items</p></div>
      </a>)}
    </div>
  </div>
  <div class="shell marquee-footer"><span>Hover to pause · Click to explore</span><span>01—09 / 09 departments</span></div>
</section>
