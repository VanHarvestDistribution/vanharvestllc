---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
import { heroImage, contact } from '@/data/site';
interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props; const zh = lang === 'zh';
---
<BaseLayout title={zh ? '关于 Van Harvest | 夏洛特食品供应商' : 'About Van Harvest Distribution | Charlotte Food Supplier'} description={zh ? '了解 Van Harvest Distribution、29,000 平方英尺仓库及其配送覆盖。' : 'Learn about Van Harvest Distribution, its 29,000-square-foot warehouse and delivery coverage.'} active="/company" lang={lang} ogImage={heroImage}>
<section class="inner-hero"><div class="shell inner-grid"><div><p class="eyebrow">{zh ? '关于 Van Harvest' : 'About Van Harvest'}</p><h1>{zh ? <>为专业厨房服务的<br /><em>务实伙伴。</em></> : <>A practical partner<br />for <em>professional kitchens.</em></>}</h1></div><div class="inner-copy"><p>{zh ? 'Van Harvest Distribution 位于 Charlotte，为餐馆、超市和餐饮团队提供从新鲜及冷冻蛋白到特色蔬果和预制食品的一站式批发目录。' : 'Based in Charlotte, Van Harvest Distribution brings a broad foodservice assortment together in one organized catalog—from fresh and frozen proteins to specialty produce and prepared foods.'}</p></div></div></section>
<div class="wide-image"><img src={heroImage} alt={zh ? '食品批发仓库' : 'Organized refrigerated food distribution warehouse'} /></div>
<section class="facts"><div class="shell"><p class="eyebrow">{zh ? 'Van Harvest 概览' : 'Van Harvest at a glance'}</p><div class="facts-grid"><article class="fact"><span>01 / {zh ? '仓库' : 'Facility'}</span><h3>29,000 SF</h3><p>{zh ? '位于 Charlotte 的大型食品批发仓库。' : 'A 29,000-square-foot wholesale food warehouse in Charlotte.'}</p></article><article class="fact"><span>02 / {zh ? '配送覆盖' : 'Delivery coverage'}</span><h3>{zh ? '四个配送区域' : 'Four delivery regions'}</h3><p>{zh ? 'North Carolina、South Carolina、Atlanta, GA 和 Virginia。' : 'North Carolina, South Carolina, Atlanta, GA and Virginia.'}</p></article><article class="fact"><span>03 / {zh ? '办公室' : 'Office'}</span><h3>{contact.phoneDisplay}</h3><p>{zh ? '拨打办公室电话，了解产品、配送和部门信息。' : 'Call the office for current product, delivery and department information.'}</p></article></div></div></section>
<section class="story"><div class="shell story-grid"><div><p class="eyebrow">{zh ? '我们的角色' : 'Our role'}</p><h2>{zh ? <>清晰选择，<br /><em>方便运营。</em></> : <>Selection with<br /><em>operational clarity.</em></>}</h2><p>{zh ? '餐馆采购需要处理很多细节。Van Harvest 用清晰的 Item #、易识别的产品名称和按厨房习惯组织的目录，让采购更简单。' : 'Restaurant purchasing is detailed work. Van Harvest keeps that work grounded in clear item numbers, recognizable product descriptions and a catalog designed around the categories kitchens use every day.'}</p><p>{zh ? `我们的 Charlotte 办公室和 ${contact.phoneDisplay} 电话，方便你咨询产品、库存和部门信息。` : `Our Charlotte location and direct phone line ${contact.phoneDisplay} make it easy to discuss products, availability and the right contact for your needs.`}</p></div><div class="principles"><div class="principle"><span>01</span><div><h3>{zh ? '目录广度' : 'Catalog depth'}</h3><p>{zh ? '涵盖多个实用部门的食品和餐饮用品。' : 'Food and foodservice items across practical departments.'}</p></div></div><div class="principle"><span>02</span><div><h3>{zh ? '品类清晰' : 'Category clarity'}</h3><p>{zh ? '按餐饮团队每天使用的品类浏览。' : 'Browse around the categories kitchens use every day.'}</p></div></div><div class="principle"><span>03</span><div><h3>{zh ? '直接联系' : 'Direct contact'}</h3><p>{zh ? '一个可靠的办公室电话和清晰的联系入口。' : 'One dependable office phone number and clear contact paths.'}</p></div></div></div></div></section>
<CallToAction lang={lang} localized />
</BaseLayout>
