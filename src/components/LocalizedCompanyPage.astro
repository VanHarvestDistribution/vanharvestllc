---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/CallToAction.astro';
import { contact } from '@/data/site';
interface Props { lang?: 'en' | 'zh'; localized?: boolean }
const { lang, localized = false } = Astro.props;
const zh = lang === 'zh';
const prefix = localized ? `/${lang}` : '';
const poster = '/images/company/van-harvest-company-poster.webp';
const coverage = zh
  ? [
      { name: '北卡罗来纳州', sub: '每天配送 · 最低 $500' },
      { name: '南卡罗来纳州', sub: '每天配送 · 最低 $500' },
      { name: '亚特兰大', sub: '按需预约 · 最低 $500' },
      { name: '维吉尼亚州', sub: '按需预约 · 最低 $500' },
    ]
  : [
      { name: 'North Carolina', sub: 'Daily delivery · $500 min' },
      { name: 'South Carolina', sub: 'Daily delivery · $500 min' },
      { name: 'Atlanta, Georgia', sub: 'Scheduled routes · $500 min' },
      { name: 'Virginia', sub: 'Scheduled routes · $500 min' },
    ];
---
<BaseLayout
  title={zh ? '公司介绍与仓储网络 | Van Harvest' : 'Company Overview & Warehouse Network | Van Harvest'}
  description={zh
    ? 'Van Harvest Distribution 成立于 2019 年，位于夏洛特 5226 Terminal St，拥有 29,000 平方英尺仓库，每日配送北卡、南卡，预约配送弗吉尼亚与亚特兰大，24 小时电话或短信下单，最低起送额 $500。'
    : 'Founded in 2019, Van Harvest operates a 29,000 SF warehouse in Charlotte, delivering daily across NC and SC with scheduled routes to VA and Atlanta. 24/7 ordering, $500 minimum.'}
  active="/company"
  lang={lang}
  ogImage={poster}
>
  <section class="company-hero">
    <div class="shell company-hero-grid">
      <div class="company-hero-copy">
        <h1>{zh ? '夏洛特食品批发与配送' : 'Charlotte Food Wholesale & Delivery'}</h1>
        <p class="company-dek">
          {zh
            ? '成立于 2019 年，Van Harvest 位于夏洛特 5226 Terminal St，拥有 29,000 平方英尺仓库。自有货车每天配送北卡与南卡，定期配送弗吉尼亚与亚特兰大。电话或短信 24 小时下单，无截单时间，每次最低起送额 $500。'
            : 'Founded in 2019, Van Harvest operates a 29,000 SF facility at 5226 Terminal St in Charlotte. Our trucks deliver daily across NC and SC, with scheduled routes to VA and Atlanta. Order 24/7 by phone or text with no cutoff time and a $500 delivery minimum.'}
        </p>
      </div>
      <figure class="company-hero-poster">
        <img src={poster} alt={zh ? 'Van Harvest Delivery 公司海报，展示仓库与配送车辆' : 'Van Harvest Delivery company poster featuring its warehouse and delivery truck'} loading="eager" />
        <figcaption>{zh ? 'Van Harvest 夏洛特仓库与车队海报' : 'Van Harvest Charlotte warehouse & fleet poster'}</figcaption>
      </figure>
    </div>
  </section>

  <section class="company-reading">
    <div class="shell company-reading-grid">
      <div>
        <h2>{zh ? '业务模式与后厨供应' : 'Wholesale operations & kitchen supply'}</h2>
      </div>
      <div class="company-prose">
        <p>
          {zh
            ? '从 2019 年开始，Van Harvest 专注于夏洛特及南北卡周边餐馆的食材日常采购。餐饮后厨需要实实在在的保障：蔬菜和水产到货必须新鲜，冷冻肉类必须温层合格，常温粮油干货和餐盒纸品必须按箱配齐。'
            : 'Since 2019, Van Harvest has focused on everyday ingredient procurement for restaurants across Charlotte and the Carolinas. Kitchens rely on concrete operational standards: produce and seafood must arrive fresh, meats must maintain strict temperature compliance, and dry staples and packaging must arrive complete.'}
        </p>
        <p>
          {zh
            ? '目前，29,000 平方英尺仓储库区支持九大品类集中配货，包含肉类禽类、蔬菜水果、活鲜水产、酱料调味、罐头腌制、餐饮耗材、米面干货、清洁用品及冷冻点心。对于华人餐馆与亚洲厨房，我们提供准确的中文名称、规格标识与熟悉的大包装规格。'
            : 'Today, our 29,000 SF warehouse supports nine full foodservice departments under one roof: meat and poultry, produce, live seafood, sauces, canned goods, restaurant packaging, dry staples, janitorial chemicals, and frozen dim sum. We provide authentic Chinese product names and standard wholesale pack formats.'}
        </p>
        <p>
          {zh
            ? '我们的流程简单直接：电话或短信 24 小时下单，无截单时间，货车直接送到店门口与司机当场核对，新客户货到付款（COD），合作满一个月可申请账期。'
            : 'Our ordering flow is direct: call or text orders anytime 24/7 without cutoff limits. Orders arrive on our refrigerated trucks for check-in at the door. New accounts pay COD, with credit terms available after one month.'}
        </p>
      </div>
    </div>
  </section>

  <section class="company-network">
    <div class="shell">
      <div class="company-network-heading">
        <div>
          <h2>{zh ? '配送网络与区域安排' : 'Regional delivery network'}</h2>
        </div>
        <p>
          {zh
            ? '以夏洛特中央仓库为中心，北卡与南卡每天有车队发车配送，弗吉尼亚与亚特兰大按需预约发车。每次最低起送额均为 $500。'
            : 'Centered at our Charlotte hub, our fleet runs daily deliveries throughout North and South Carolina, with scheduled routes to Virginia and Atlanta. $500 minimum per delivery.'}
        </p>
      </div>
      <div class="network-plot" role="img" aria-label={zh ? 'Van Harvest 配送网络：Charlotte 连接北卡、南卡、亚特兰大和维吉尼亚' : 'Van Harvest delivery network: Charlotte connects to North Carolina, South Carolina, Atlanta and Virginia'}>
        <div class="network-origin">
          <span>{zh ? '中央仓库' : 'Central warehouse'}</span>
          <strong>Charlotte, NC</strong>
          <small>{zh ? '29,000 SF · 5226 Terminal St' : '29,000 SF · 5226 Terminal St'}</small>
        </div>
        <div class="network-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="network-destinations">
          {coverage.map((place) => (
            <article class="network-node">
              <strong>{place.name}</strong>
              <span>{place.sub}</span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="company-poster-story">
    <div class="shell company-poster-grid">
      <div class="company-poster-copy">
        <h2>{zh ? '一站式采购品类' : 'One-stop wholesale assortment'}</h2>
        <p>
          {zh
            ? '从活海鲜暂养缸水产、冻肉生肉，到食用油、米面粮油、调味酱料和一次性外卖盒，餐厅常用的品类均可在 Van Harvest 一站式采购。'
            : 'From live holding tank seafood and meats to cooking oils, rice, specialty Asian sauces and takeout containers, restaurants can consolidate everyday orders with Van Harvest.'}
        </p>
        <a class="text-link" href={`${prefix}/products/`}>{zh ? '浏览九大产品分类 →' : 'Explore nine departments →'}</a>
      </div>
      <div class="company-poster-quote">
        <p>{zh ? '“万家餐饮源，客户生意昌。”' : '“Supplying kitchens, supporting restaurants.”'}</p>
        <span>{zh ? `夏洛特办公室 · 电话 / 短信：${contact.phoneDisplay}` : `Charlotte office · Phone / Text: ${contact.phoneDisplay}`}</span>
      </div>
    </div>
  </section>

  <CallToAction lang={lang} localized={localized} />
</BaseLayout>
