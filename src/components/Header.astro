---
interface Props { active?: string; lang?: 'en' | 'zh' }
const { active = '', lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const isZh = lang === 'zh';

// Ensure paths are cleanly normalized with trailing slashes
const normalizedPath = path.endsWith('/') ? path : `${path}/`;
const cleanPath = normalizedPath.replace(/^\/zh(?=\/|$)/, '') || '/';
const normalizedCleanPath = cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;

const localHref = (href: string) => {
  const target = href === '/' ? '/' : (href.endsWith('/') ? href : `${href}/`);
  return isZh ? (target === '/' ? '/zh/' : `/zh${target}`) : target;
};

const switchHref = isZh ? normalizedCleanPath : (normalizedCleanPath === '/' ? '/zh/' : `/zh${normalizedCleanPath}`);

const items = [
  [isZh ? '首页' : 'Home', '/'],
  [isZh ? '产品目录' : 'Products', '/products/'],
  [isZh ? '公司介绍' : 'Company', '/company/'],
  [isZh ? '服务' : 'Services', '/services/'],
  [isZh ? '联系我们' : 'Contact', '/contact/']
];

const mobileItems = [
  items[0],
  items[1],
  [isZh ? '购物车 / 提交订单' : 'Order cart', '/cart/'],
  [isZh ? '申请开户' : 'Apply for an account', '/apply/'],
  [isZh ? '配送范围' : 'Delivery areas', '/delivery/'],
  [isZh ? '服务客户' : 'Who we serve', '/industries/'],
  ...items.slice(2)
];

const activeNormalized = active.endsWith('/') ? active : (active === '' ? '' : `${active}/`);
---
<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand official-brand" href={localHref('/')} aria-label="Van Harvest LLC home">
      <img class="brand-logo brand-logo-dark" src="/brand/van-harvest-official.webp" width="142" height="101" alt="Van Harvest LLC" />
      <img class="brand-logo brand-logo-light" src="/brand/van-harvest-official-light.webp" width="142" height="101" alt="Van Harvest LLC logo" aria-hidden="true" />
    </a>

    <nav class="desktop-nav" aria-label={isZh ? '主导航' : 'Primary navigation'}>
      {items.map(([label, href]) => (
        <a href={localHref(href)} class:list={{ active: activeNormalized === href || (href === '/products/' && activeNormalized.startsWith('/products/')) }}>{label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      <a class="language-switch language-switch-active" href={switchHref}>{isZh ? 'EN' : '中文'}</a>
    </nav>

    <div class="header-actions-group">
      <a class="header-cart" href={localHref('/cart/')} data-cart-link aria-label={isZh ? '购物车' : 'Order cart'}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.1"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>
        <span class="header-cart-label">{isZh ? '购物车' : 'Cart'}</span>
        <span class="header-cart-count" data-cart-count hidden>0</span>
      </a>
      <a class="header-apply button header-apply-desktop" href={localHref('/apply/')}>{isZh ? '申请开户' : 'Apply for an account'}</a>
      <a class="header-apply-mobile button" href={localHref('/apply/')}>{isZh ? '开户' : 'Apply'}</a>
      <button class="menu-toggle" type="button" aria-label={isZh ? '打开菜单' : 'Open menu'} aria-expanded="false" data-menu-toggle>
        <b class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></b>
        <span>{isZh ? '菜单' : 'Menu'}</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" data-mobile-menu aria-hidden="true">
  <div class="mobile-drawer-top">
    <a class="brand official-brand" href={localHref('/')}>
      <img class="brand-logo brand-logo-dark" src="/brand/van-harvest-official.webp" width="142" height="101" alt="Van Harvest LLC" />
      <img class="brand-logo brand-logo-light" src="/brand/van-harvest-official-light.webp" width="142" height="101" alt="Van Harvest LLC logo" aria-hidden="true" />
    </a>
    <div class="mobile-drawer-actions">
      <a class="mobile-language" href={switchHref}>{isZh ? 'English (EN)' : '中文界面'}</a>
      <button type="button" aria-label={isZh ? '关闭菜单' : 'Close menu'} data-menu-close>{isZh ? '关闭' : 'Close'}</button>
    </div>
  </div>
  <nav aria-label="Mobile navigation">
    {mobileItems.map(([label, href]) => (
      <a href={localHref(href)}><span class="mobile-menu-label">{label}</span><b aria-hidden="true">↗</b></a>
    ))}
  </nav>
  <div class="mobile-drawer-contact">
    <span>{isZh ? '夏洛特办公室' : 'Charlotte office'}</span>
    <a href="tel:+17043928717">(704) 392-8717</a>
    <p>5226 Terminal St<br />Charlotte, NC 28208</p>
  </div>
</div>

<script is:inline>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const close = document.querySelector('[data-menu-close]');
  const menu = document.querySelector('[data-mobile-menu]');
  const setMenu = (open) => {
    menu?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-hidden', String(!open));
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  close?.addEventListener('click', () => setMenu(false));
  const updateScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  addEventListener('scroll', updateScrolled, { passive: true });
  addEventListener('pageshow', () => setMenu(false));
  addEventListener('pagehide', () => setMenu(false));
  updateScrolled();
</script>
