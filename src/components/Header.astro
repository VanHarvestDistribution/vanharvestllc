---
interface Props { active?: string; lang?: 'en' | 'zh' }
const { active = '', lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const isLocalized = path === '/en' || path.startsWith('/en/') || path === '/zh' || path.startsWith('/zh/');
const prefix = isLocalized ? `/${lang}` : '';
const localHref = (href: string) => `${prefix}${href === '/' ? '' : href}` || '/';
const switchHref = lang === 'zh'
  ? (path.replace(/^\/zh(?=\/|$)/, '') || '/')
  : (path.startsWith('/en') ? (path.replace(/^\/en(?=\/|$)/, '/zh') || '/zh') : `/zh${path === '/' ? '' : path}`);
const items = [
  [lang === 'zh' ? '首页' : 'Home', '/'],
  [lang === 'zh' ? '产品目录' : 'Products', '/products'],
  [lang === 'zh' ? '完整目录' : 'Full Catalog', '/products/catalog'],
  [lang === 'zh' ? '公司介绍' : 'Company', '/company'],
  [lang === 'zh' ? '服务' : 'Services', '/services'],
  [lang === 'zh' ? '联系我们' : 'Contact', '/contact']
];
---
<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand official-brand" href={localHref('/')} aria-label="Van Harvest Distribution home"><img src="/brand/van-harvest-official.png" width="142" height="101" alt="Van Harvest Distribution" /></a>
    <nav class="desktop-nav" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
    {items.map(([label, href]) => <a href={localHref(href)} class:list={{ active: active === href || (href === '/products' && active === '/products') }}>{label}</a>)}<span class="nav-divider" aria-hidden="true"></span><a class="language-switch language-switch-active" href={switchHref}>{lang === 'zh' ? 'EN' : '中文'}</a>
    </nav>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
      <i></i><i></i><span>Menu</span>
    </button>
  </div>
</header>
<div class="mobile-drawer" data-mobile-menu aria-hidden="true">
  <div class="mobile-drawer-top">
      <a class="brand official-brand" href={localHref('/')}><img src="/brand/van-harvest-official.png" width="142" height="101" alt="Van Harvest Distribution" /></a>
    <button type="button" aria-label={lang === 'zh' ? '关闭菜单' : 'Close menu'} data-menu-close>{lang === 'zh' ? '关闭' : 'Close'}</button>
  </div>
  <nav aria-label="Mobile navigation">
    {items.map(([label, href]) => <a href={localHref(href)}>{label}<b aria-hidden="true">↗</b></a>)}
  </nav>
  <div class="mobile-drawer-contact"><span>{lang === 'zh' ? '语言 / Language' : 'Language / 语言'}</span><p><a href={switchHref}>{lang === 'zh' ? 'English' : '中文'}</a></p><span>{lang === 'zh' ? '夏洛特办公室' : 'Charlotte office'}</span><a href="tel:+17043928717">(704) 392-8717</a><p>5226 Terminal St<br />Charlotte, NC 28208</p></div>
</div>
<script is:inline>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const close = document.querySelector('[data-menu-close]');
  const menu = document.querySelector('[data-mobile-menu]');
  const setMenu = (open) => {
    menu?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-hidden', String(!open));
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  close?.addEventListener('click', () => setMenu(false));
  addEventListener('scroll', () => header?.classList.toggle('is-scrolled', scrollY > 18), { passive: true });
</script>
